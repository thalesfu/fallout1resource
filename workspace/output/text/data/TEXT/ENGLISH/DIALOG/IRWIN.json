    },
    {
      "occurrence": 10,
      "number": 103,
      "number_raw": "103",
      "source_number": "103",
      "audio": "",
      "source_audio": "",
      "text": "看起来你是唯一惹上麻烦的人。",
      "source_text": "看起来你是唯一惹上麻烦的人。",
      "source_line_start": 14,
