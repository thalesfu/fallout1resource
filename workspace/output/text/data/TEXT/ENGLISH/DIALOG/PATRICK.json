      "effective": true
    },
    {
      "occurrence": 81,
      "number": 139,
      "number_raw": "139",
      "source_number": "139",
      "audio": "",
      "source_audio": "",
      "text": "The Hub is a major trading center. It's said that you can find anything# there, and I'd say that's not too far wrong.",
      "source_text": "The Hub is a major trading center. It's said that you can find anything\n# there, and I'd say that's not too far wrong.",
