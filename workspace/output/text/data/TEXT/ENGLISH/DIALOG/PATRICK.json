      "number": 130,
      "number_raw": "130",
      "source_number": "130",
      "audio": "",
      "source_audio": "",
      "text": "真的？你能修好水处理芯片吗？",
      "source_text": "真的？你能修好水处理芯片吗？",
      "source_line_start": 103,
      "source_line_end": 103,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 65,
      "number": 131,
      "number_raw": "131",
      "source_number": "131",
      "audio": "",
      "source_audio": "",
      "text": "Oh, mostly old folk songs and some Celtic music. It's a change of pace.",
      "source_text": "Oh, mostly old folk songs and some Celtic music. It's a change of pace.",
      "source_line_start": 105,
      "source_line_end": 105,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
