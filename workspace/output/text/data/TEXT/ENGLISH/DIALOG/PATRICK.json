      "effective": false
    },
    {
      "occurrence": 78,
      "number": 137,
      "number_raw": "137",
      "source_number": "137",
      "audio": "",
      "source_audio": "",
      "text": "迦克镇？一个小商业城市，你要刚去可能会不习惯，那是个奇怪的地方。那里被吉斯莫控制着，一个无恶不作的赌徒。",
      "source_text": "迦克镇？一个小商业城市，你要刚去可能会不习惯，那是个奇怪的地方。那里被吉斯莫控制着，一个无恶不作的赌徒。",
      "source_line_start": 130,
      "source_line_end": 130,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 79,
      "number": 138,
      "number_raw": "138",
      "source_number": "138",
      "audio": "",
      "source_audio": "",
      "text": "Junktown? A small trading city. Not too remarkable.",
      "source_text": "Junktown? A small trading city. Not too remarkable.",
