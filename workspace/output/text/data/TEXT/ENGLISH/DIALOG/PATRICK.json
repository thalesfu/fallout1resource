    },
    {
      "occurrence": 80,
      "number": 138,
      "number_raw": "138",
      "source_number": "138",
      "audio": "",
      "source_audio": "",
      "text": "迦克镇？一个小商业城市，很一般，没什么可以说的。",
      "source_text": "迦克镇？一个小商业城市，很一般，没什么可以说的。",
