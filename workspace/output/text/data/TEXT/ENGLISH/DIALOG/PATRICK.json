      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 62,
      "number": 129,
      "number_raw": "129",
      "source_number": "129",
      "audio": "",
      "source_audio": "",
      "text": "通常是电、机械方面的修理。例如迦克镇的照明啊，我让沙荫镇的人用上更好的炉子。",
      "source_text": "通常是电、机械方面的修理。例如迦克镇的照明啊，我让沙荫镇的人用上更好的炉子。",
      "source_line_start": 100,
      "source_line_end": 100,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 63,
      "number": 130,
      "number_raw": "130",
      "source_number": "130",
      "audio": "",
      "source_audio": "",
      "text": "Really? Think you could fix a water chip?",
      "source_text": "Really? Think you could fix a water chip?",
      "source_line_start": 102,
