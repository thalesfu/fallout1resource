    },
    {
      "occurrence": 61,
      "number": 129,
      "number_raw": "129",
      "source_number": "129",
      "audio": "",
      "source_audio": "",
      "text": "Mostly a little electrical and mechanical tinkering. I helped Junktown with# their lights and showed the people in Shady Sands a better design for their# stoves.",
      "source_text": "Mostly a little electrical and mechanical tinkering. I helped Junktown with\n# their lights and showed the people in Shady Sands a better design for their\n# stoves.",
      "source_line_start": 97,
