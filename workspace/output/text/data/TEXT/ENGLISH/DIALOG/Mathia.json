      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 13,
      "number": 105,
      "number_raw": "105",
      "source_number": "105",
      "audio": "",
      "source_audio": "",
      "text": "The name is Mathia. I am officially Maxson's assistant, but#I am also here to make sure no one messes with the old man.",
      "source_text": "The name is Mathia. I am officially Maxson's assistant, but\n#I am also here to make sure no one messes with the old man.",
      "source_line_start": 20,
      "source_line_end": 21,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 14,
      "number": 105,
      "number_raw": "105",
      "source_number": "105",
      "audio": "",
      "source_audio": "",
      "text": "我的名字叫马蒂雅。职务上我是马克松将军的助手，但我还要确保没人打扰这个老头。",
      "source_text": "我的名字叫马蒂雅。职务上我是马克松将军的助手，但我还要确保没人打扰这个老头。",
      "source_line_start": 22,
