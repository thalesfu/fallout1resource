      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 15,
      "number": 106,
      "number_raw": "106",
      "source_number": "106",
      "audio": "",
      "source_audio": "",
      "text": "Old man? That sounds a bit disrespectful.",
      "source_text": "Old man? That sounds a bit disrespectful.",
      "source_line_start": 24,
      "source_line_end": 24,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
