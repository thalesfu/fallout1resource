      "number_raw": "104",
      "source_number": "104",
      "audio": "",
      "source_audio": "",
      "text": "Hello. I'm sorry, but I'm not feeling too well right now.# Please, if you can help find a way to fight the radscorpions,# talk to my brother, Seth.",
      "source_text": "Hello. I'm sorry, but I'm not feeling too well right now.\n# Please, if you can help find a way to fight the radscorpions,\n# talk to my brother, Seth.",
