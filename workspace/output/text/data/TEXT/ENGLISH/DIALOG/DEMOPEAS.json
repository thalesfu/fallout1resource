      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 8,
      "number": 102,
      "number_raw": "102",
      "source_number": "102",
      "audio": "",
      "source_audio": "",
      "text": "你在做什么？费尔？你在检查那些潜入者的足迹，是吗？",
      "source_text": "你在做什么？费尔？你在检查那些潜入者的足迹，是吗？",
      "source_line_start": 9,
      "source_line_end": 9,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 9,
      "number": 103,
      "number_raw": "103",
      "source_number": "103",
      "audio": "",
      "source_audio": "",
      "text": "Man, that dog looks hungry. It sure wants to eat you alive, Phil.",
      "source_text": "Man, that dog looks hungry. It sure wants to eat you alive, Phil.",
      "source_line_start": 10,
      "source_line_end": 10,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 10,
      "number": 103,
      "number_raw": "103",
      "source_number": "103",
      "audio": "",
      "source_audio": "",
      "text": "嘿，那条狗看起来很饿了。它看起来想活吞了你，费尔。",
      "source_text": "嘿，那条狗看起来很饿了。它看起来想活吞了你，费尔。",
