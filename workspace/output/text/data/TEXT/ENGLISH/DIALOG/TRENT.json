      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 39,
      "number": 136,
      "number_raw": "136",
      "source_number": "136",
      "audio": "",
      "source_audio": "",
      "text": "They're huge. Like big lizards, but leathery. Huge claws, and teeth, huge# horns and they love the taste of humans. And fast, God they're fast. I'm just# glad they decided not to chase me, or I'd be dead.",
      "source_text": "They're huge. Like big lizards, but leathery. Huge claws, and teeth, huge\n# horns and they love the taste of humans. And fast, God they're fast. I'm just\n# glad they decided not to chase me, or I'd be dead.",
      "source_line_start": 56,
      "source_line_end": 58,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
