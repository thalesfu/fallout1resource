      "number_raw": "127",
      "source_number": "127",
      "audio": "",
      "source_audio": "",
      "text": "Huge horns, sick red skin, like something out of a story about demons,# and it at Joe in three gulps . . .",
      "source_text": "Huge horns, sick red skin, like something out of a story about demons,\n# and it at Joe in three gulps . . .",
