      "effective": false
    },
    {
      "occurrence": 37,
      "number": 134,
      "number_raw": "134",
      "source_number": "134",
      "audio": "",
      "source_audio": "",
      "text": "Trent, Trent Barrister. I live in the Hub. Lately work's been getting# scarce, and I'm a pretty good shot, so I hired myself as a guard to the Water# Merchants. Pay's good, the risk's low - or so I thought.",
      "source_text": "Trent, Trent Barrister. I live in the Hub. Lately work's been getting\n# scarce, and I'm a pretty good shot, so I hired myself as a guard to the Water\n# Merchants. Pay's good, the risk's low - or so I thought.",
      "source_line_start": 50,
      "source_line_end": 52,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 38,
      "number": 135,
      "number_raw": "135",
      "source_number": "135",
      "audio": "",
      "source_audio": "",
      "text": "I haven't a clue. That's old tech, ain't it? I suppose scavengers might# find one, now and a gain, but I wouldn't begin to know where to look. No# one uses them any more - do they?",
      "source_text": "I haven't a clue. That's old tech, ain't it? I suppose scavengers might\n# find one, now and a gain, but I wouldn't begin to know where to look. No\n# one uses them any more - do they?",
      "source_line_start": 53,
