    {
      "occurrence": 36,
      "number": 133,
      "number_raw": "133",
      "source_number": "133",
      "audio": "",
      "source_audio": "",
      "text": "Death Claws got 'em. I just thought they were stories, but . . . you# wouldn't believe how big they are, or how fast. First we smelled them, then# they came over the ridge and tore into us. We all ran, and somehow I got away.",
      "source_text": "Death Claws got 'em. I just thought they were stories, but . . . you\n# wouldn't believe how big they are, or how fast. First we smelled them, then\n# they came over the ridge and tore into us. We all ran, and somehow I got away.",
      "source_line_start": 47,
