      "number": 130,
      "number_raw": "130",
      "source_number": "130",
      "audio": "",
      "source_audio": "",
      "text": "I don't care if it's a mutant, an alien, or a demon from Hell, I never# want to see another one of those things as long as I live!",
      "source_text": "I don't care if it's a mutant, an alien, or a demon from Hell, I never\n# want to see another one of those things as long as I live!",
      "source_line_start": 42,
