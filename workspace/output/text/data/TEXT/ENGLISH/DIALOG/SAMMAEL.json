    {
      "occurrence": 61,
      "number": 129,
      "number_raw": "129",
      "source_number": "129",
      "audio": "",
      "source_audio": "",
      "text": "The Blades are a pretty sorry sight for a group of people.# They get by though, and some of them end up here in Adytum if they agree# to what the Regulators offer them to do.",
      "source_text": "The Blades are a pretty sorry sight for a group of people.\n# They get by though, and some of them end up here in Adytum if they agree\n# to what the Regulators offer them to do.",
      "source_line_start": 97,
