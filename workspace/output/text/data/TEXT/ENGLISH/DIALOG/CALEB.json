    },
    {
      "occurrence": 37,
      "number": 117,
      "number_raw": "117",
      "source_number": "117",
      "audio": "",
      "source_audio": "",
      "text": "I'm Caleb. I train and organize the Regulators here.",
      "source_text": "I'm Caleb. I train and organize the Regulators here.",
      "source_line_start": 40,
      "source_line_end": 40,
      "number_occurrence": 1,
