    },
    {
      "occurrence": 60,
      "number": 128,
      "number_raw": "128",
      "source_number": "128",
      "audio": "",
      "source_audio": "",
      "text": "内城区由乔恩·齐默曼管理。他是个正直的人，把那里治理得很好，你应该去见见他。还有事情吗？",
      "source_text": "内城区由乔恩·齐默曼管理。他是个正直的人，把那里治理得很好，你应该去见见他。还有事情吗？",
      "source_line_start": 68,
