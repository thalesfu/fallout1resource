      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 61,
      "number": 129,
      "number_raw": "129",
      "source_number": "129",
      "audio": "",
      "source_audio": "",
      "text": "Tine runs a shop over near the gates. It's down below the little bunker.# He does all th' tradin' with the Hub and with outsiders like you. Anything else?",
      "source_text": "Tine runs a shop over near the gates. It's down below the little bunker.\n# He does all th' tradin' with the Hub and with outsiders like you. Anything else?",
