      "effective": true
    },
    {
      "occurrence": 63,
      "number": 130,
      "number_raw": "130",
      "source_number": "130",
      "audio": "",
      "source_audio": "",
      "text": "We are the police force for Adytum. Most folks 'round here know# enough not to cause any trouble.",
      "source_text": "We are the police force for Adytum. Most folks 'round here know\n# enough not to cause any trouble.",
      "source_line_start": 72,
