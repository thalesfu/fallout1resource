    {
      "occurrence": 35,
      "number": 116,
      "number_raw": "116",
      "source_number": "116",
      "audio": "",
      "source_audio": "",
      "text": "Stay out of trouble, got it?# I'm Caleb, and that's a name for you to remember,# 'cause I'll be the one comin' after you if you screw up.",
      "source_text": "Stay out of trouble, got it?\n# I'm Caleb, and that's a name for you to remember,\n# 'cause I'll be the one comin' after you if you screw up.",
      "source_line_start": 36,
      "source_line_end": 38,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 36,
      "number": 116,
      "number_raw": "116",
      "source_number": "116",
      "audio": "",
      "source_audio": "",
      "text": "别惹麻烦，明白吗？我是卡勒布，你给我记住这个名字，如果你犯事了，叫这个名字的人会来逮你的。",
      "source_text": "别惹麻烦，明白吗？我是卡勒布，你给我记住这个名字，如果你犯事了，叫这个名字的人会来逮你的。",
      "source_line_start": 39,
