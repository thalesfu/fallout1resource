      "number": 128,
      "number_raw": "128",
      "source_number": "128",
      "audio": "",
      "source_audio": "",
      "text": "Adytum here's run by Jon Zimmerman. He's an upright fella,# takes good care o' the town. You should go an' see 'im. Anything else?",
      "source_text": "Adytum here's run by Jon Zimmerman. He's an upright fella,\n# takes good care o' the town. You should go an' see 'im. Anything else?",
      "source_line_start": 66,
