      "number_raw": "130",
      "source_number": "130",
      "audio": "",
      "source_audio": "",
      "text": "我们是内城区的警察，多数居民知道犯事的下场。",
      "source_text": "我们是内城区的警察，多数居民知道犯事的下场。",
