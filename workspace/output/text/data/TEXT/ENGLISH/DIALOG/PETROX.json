      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 8,
      "number": 105,
      "number_raw": "105",
      "source_number": "105",
      "audio": "",
      "source_audio": "",
      "text": "Hroo?",
      "source_text": "Hroo?",
      "source_line_start": 9,
      "source_line_end": 9,
