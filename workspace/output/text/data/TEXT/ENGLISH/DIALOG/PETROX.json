      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 20,
      "number": 117,
      "number_raw": "117",
      "source_number": "117",
      "audio": "",
      "source_audio": "",
      "text": "I've been to many places in the wastelands. The closest places that I've# been to are Shady Sands and Junktown. Not much happens in those places, but# they are always full of information and supplies.",
      "source_text": "I've been to many places in the wastelands. The closest places that I've\n# been to are Shady Sands and Junktown. Not much happens in those places, but\n# they are always full of information and supplies.",
