      "source_text": "What is Junktown?",
      "source_line_start": 20,
      "source_line_end": 20,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 16,
      "number": 113,
      "number_raw": "113",
      "source_number": "113",
      "audio": "",
      "source_audio": "",
      "text": "I am sorry, but I don't have time to waste on those who are slow. Good bye.",
      "source_text": "I am sorry, but I don't have time to waste on those who are slow. Good bye.",
      "source_line_start": 21,
      "source_line_end": 21,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 17,
      "number": 114,
      "number_raw": "114",
      "source_number": "114",
      "audio": "",
      "source_audio": "",
      "text": "We never steal. We just take the extra that others have and redistribute #it# among our hungry people.",
      "source_text": "We never steal. We just take the extra that others have and redistribute #it\n# among our hungry people.",
      "source_line_start": 22,
      "source_line_end": 23,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
