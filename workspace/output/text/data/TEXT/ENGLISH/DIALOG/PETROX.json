      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 9,
      "number": 106,
      "number_raw": "106",
      "source_number": "106",
      "audio": "",
      "source_audio": "",
      "text": "As a raider, I get to travel to many parts of the wasteland. In my# travels, I get supplies for the camp.",
      "source_text": "As a raider, I get to travel to many parts of the wasteland. In my\n# travels, I get supplies for the camp.",
      "source_line_start": 10,
      "source_line_end": 11,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 10,
      "number": 107,
      "number_raw": "107",
      "source_number": "107",
      "audio": "",
      "source_audio": "",
      "text": "In other words, you steal from the people you go to.",
      "source_text": "In other words, you steal from the people you go to.",
      "source_line_start": 12,
      "source_line_end": 12,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 11,
      "number": 108,
      "number_raw": "108",
      "source_number": "108",
      "audio": "",
      "source_audio": "",
      "text": "Hey, that's really great of you. I'm sure that Garl is pleased with you.",
      "source_text": "Hey, that's really great of you. I'm sure that Garl is pleased with you.",
      "source_line_start": 13,
      "source_line_end": 13,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 12,
      "number": 109,
      "number_raw": "109",
      "source_number": "109",
      "audio": "",
      "source_audio": "",
      "text": "What places have you been to?",
      "source_text": "What places have you been to?",
      "source_line_start": 14,
      "source_line_end": 14,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 13,
      "number": 110,
      "number_raw": "110",
      "source_number": "110",
      "audio": "",
      "source_audio": "",
      "text": "Well, it's nice that you think that you are so important that you don't need #a# name to go around here. But, I will at least tell you a little about us. We# are the toughest people in the wastelands. No one can stand against us. Not# even those wimps from Shady Sands or Junktown.",
      "source_text": "Well, it's nice that you think that you are so important that you don't need #a\n# name to go around here. But, I will at least tell you a little about us. We\n# are the toughest people in the wastelands. No one can stand against us. Not\n# even those wimps from Shady Sands or Junktown.",
      "source_line_start": 15,
      "source_line_end": 18,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 14,
      "number": 111,
      "number_raw": "111",
      "source_number": "111",
      "audio": "",
      "source_audio": "",
      "text": "What about Shady Sands?",
      "source_text": "What about Shady Sands?",
      "source_line_start": 19,
      "source_line_end": 19,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 15,
      "number": 112,
      "number_raw": "112",
      "source_number": "112",
      "audio": "",
      "source_audio": "",
