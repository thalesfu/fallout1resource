      "number_raw": "101",
      "source_number": "101",
      "audio": "",
      "source_audio": "",
      "text": "Greetings! I am Petrox. I am one of Garl's lead raiders. Who are you?",
      "source_text": "Greetings! I am Petrox. I am one of Garl's lead raiders. Who are you?",
      "source_line_start": 5,
