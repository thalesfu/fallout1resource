      "occurrence": 23,
      "number": 110,
      "number_raw": "110",
      "source_number": "110",
      "audio": "",
      "source_audio": "",
      "text": "I'd recommend that you check out Tine's store, just to one side of the gates. I#don't actually sell anything here; I trade it to Tine or the Hub merchants for goods.",
      "source_text": "I'd recommend that you check out Tine's store, just to one side of the gates. I\n#don't actually sell anything here; I trade it to Tine or the Hub merchants for goods.",
      "source_line_start": 34,
