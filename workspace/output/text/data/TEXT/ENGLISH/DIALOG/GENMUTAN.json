      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 53,
      "number": 125,
      "number_raw": "125",
      "source_number": "125",
      "audio": "",
      "source_audio": "",
      "text": "What question? I said 'Hail to the Master, goodbye.'",
      "source_text": "What question? I said 'Hail to the Master, goodbye.'",
      "source_line_start": 79,
      "source_line_end": 79,
