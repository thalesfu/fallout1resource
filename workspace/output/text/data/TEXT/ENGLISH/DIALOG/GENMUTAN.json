      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 49,
      "number": 123,
      "number_raw": "123",
      "source_number": "123",
      "audio": "",
      "source_audio": "",
      "text": "Oh, uh, no reason.",
      "source_text": "Oh, uh, no reason.",
      "source_line_start": 73,
