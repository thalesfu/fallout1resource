      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 51,
      "number": 124,
      "number_raw": "124",
      "source_number": "124",
      "audio": "",
      "source_audio": "",
      "text": "I am going to kick his ass from here to, uh, someplace really far away!",
      "source_text": "I am going to kick his ass from here to, uh, someplace really far away!",
      "source_line_start": 76,
      "source_line_end": 76,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 52,
      "number": 124,
      "number_raw": "124",
      "source_number": "124",
      "audio": "",
      "source_audio": "",
      "text": "从今以后我准备踢他的屁股，呃，确实距离比较远。",
      "source_text": "从今以后我准备踢他的屁股，呃，确实距离比较远。",
      "source_line_start": 77,
