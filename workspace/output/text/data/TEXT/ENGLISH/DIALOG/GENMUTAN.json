      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 54,
      "number": 125,
      "number_raw": "125",
      "source_number": "125",
      "audio": "",
      "source_audio": "",
      "text": "什么问题？我说了，“向主教致意，再见。”",
      "source_text": "什么问题？我说了，“向主教致意，再见。”",
      "source_line_start": 80,
