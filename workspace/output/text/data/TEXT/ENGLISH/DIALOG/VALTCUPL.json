    },
    {
      "occurrence": 4,
      "number": 100,
      "number_raw": "100",
      "source_number": "100",
      "audio": "",
      "source_audio": "",
      "text": "你看到一个13号避难所的公民。",
      "source_text": "你看到一个13号避难所的公民。",
      "source_line_start": 5,
      "source_line_end": 5,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 5,
      "number": 101,
      "number_raw": "101",
      "source_number": "101",
      "audio": "",
      "source_audio": "",
      "text": "We didn't think that you were coming back. You have# such a nice room, and we were a little crowded with# her parents. I hope you don't mind.",
      "source_text": "We didn't think that you were coming back. You have\n# such a nice room, and we were a little crowded with\n# her parents. I hope you don't mind.",
      "source_line_start": 7,
      "source_line_end": 9,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 6,
      "number": 101,
      "number_raw": "101",
      "source_number": "101",
      "audio": "",
      "source_audio": "",
      "text": "我们没想到你回来了。你的房间挺漂亮，而我俩和她父母住在一起有点挤……我希望你不会介意。",
      "source_text": "我们没想到你回来了。你的房间挺漂亮，而我俩和她父母住在一起有点挤……我希望你不会介意。",
      "source_line_start": 10,
      "source_line_end": 10,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 7,
      "number": 102,
      "number_raw": "102",
      "source_number": "102",
      "audio": "",
      "source_audio": "",
      "text": "Yes, I do mind. Get out of my room!",
      "source_text": "Yes, I do mind. Get out of my room!",
      "source_line_start": 12,
      "source_line_end": 12,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 8,
      "number": 102,
      "number_raw": "102",
      "source_number": "102",
      "audio": "",
      "source_audio": "",
      "text": "不，我介意。滚出我的房间！",
      "source_text": "不，我介意。滚出我的房间！",
      "source_line_start": 13,
      "source_line_end": 13,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 9,
      "number": 103,
      "number_raw": "103",
      "source_number": "103",
      "audio": "",
      "source_audio": "",
      "text": "Nah, I don't care. Enjoy the room.",
      "source_text": "Nah, I don't care. Enjoy the room.",
      "source_line_start": 15,
      "source_line_end": 15,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 10,
      "number": 103,
      "number_raw": "103",
      "source_number": "103",
      "audio": "",
      "source_audio": "",
      "text": "啊，我不介意。祝你们住的愉快。",
      "source_text": "啊，我不介意。祝你们住的愉快。",
      "source_line_start": 16,
      "source_line_end": 16,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 11,
      "number": 104,
      "number_raw": "104",
      "source_number": "104",
      "audio": "",
      "source_audio": "",
      "text": "It would be reassuring to have my own quarters back.# Please find somewhere else to live.",
      "source_text": "It would be reassuring to have my own quarters back.\n# Please find somewhere else to live.",
      "source_line_start": 18,
      "source_line_end": 19,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 12,
      "number": 104,
      "number_raw": "104",
      "source_number": "104",
      "audio": "",
      "source_audio": "",
      "text": "把我的宿舍拿回来能让我感到安心。你们还是请另寻它处吧。",
      "source_text": "把我的宿舍拿回来能让我感到安心。你们还是请另寻它处吧。",
