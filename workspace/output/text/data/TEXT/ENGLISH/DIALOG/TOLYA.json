    },
    {
      "occurrence": 20,
      "number": 108,
      "number_raw": "108",
      "source_number": "108",
      "audio": "",
      "source_audio": "",
      "text": "嘿！你真是太棒了。我确信伽尔会对你感到高兴的。",
      "source_text": "嘿！你真是太棒了。我确信伽尔会对你感到高兴的。",
      "source_line_start": 21,
