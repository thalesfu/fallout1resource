      "number_raw": "110",
      "source_number": "110",
      "audio": "",
      "source_audio": "",
      "text": "Come now, Garl tells me never to talk to strangers. You should at least be willing to tell me your name.",
      "source_text": "Come now, Garl tells me never to talk to strangers. You should at least be willing to tell me your name.",
      "source_line_start": 24,
      "source_line_end": 24,
      "number_occurrence": 1,
