    },
    {
      "occurrence": 13,
      "number": 105,
      "number_raw": "105",
      "source_number": "105",
      "audio": "",
      "source_audio": "",
      "text": "Urgh?",
      "source_text": "Urgh?",
      "source_line_start": 14,
      "source_line_end": 14,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 14,
      "number": 105,
      "number_raw": "105",
      "source_number": "105",
      "audio": "",
      "source_audio": "",
      "text": "呃？",
      "source_text": "呃？",
      "source_line_start": 15,
