      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 15,
      "number": 106,
      "number_raw": "106",
      "source_number": "106",
      "audio": "",
      "source_audio": "",
      "text": "As a raider, I explore the lands in search of new supplies. There have been some towns which have been graced by our presence.",
      "source_text": "As a raider, I explore the lands in search of new supplies. There have been some towns which have been graced by our presence.",
      "source_line_start": 16,
      "source_line_end": 16,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 16,
      "number": 106,
      "number_raw": "106",
      "source_number": "106",
      "audio": "",
      "source_audio": "",
      "text": "作为一个强盗，我为了寻找新的补给探索大陆。有几个镇因为我们的出现变得“热闹”了。",
      "source_text": "作为一个强盗，我为了寻找新的补给探索大陆。有几个镇因为我们的出现变得“热闹”了。",
      "source_line_start": 17,
      "source_line_end": 17,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 17,
      "number": 107,
      "number_raw": "107",
      "source_number": "107",
      "audio": "",
      "source_audio": "",
      "text": "In other words, you steal from the people you visit.",
      "source_text": "In other words, you steal from the people you visit.",
      "source_line_start": 18,
      "source_line_end": 18,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
