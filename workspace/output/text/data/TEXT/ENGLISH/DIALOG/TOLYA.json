    },
    {
      "occurrence": 49,
      "number": 123,
      "number_raw": "123",
      "source_number": "123",
      "audio": "",
      "source_audio": "",
      "text": "Yes, we go to Shady Sands from time to time. It adds a little excitement to the lives of everyone concerned.",
      "source_text": "Yes, we go to Shady Sands from time to time. It adds a little excitement to the lives of everyone concerned.",
      "source_line_start": 50,
