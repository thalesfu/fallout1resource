      "source_number": "101",
      "audio": "",
      "source_audio": "",
      "text": "Hello, I am Tolya. Looks like you just wandered in from the desert. Who are you?",
      "source_text": "Hello, I am Tolya. Looks like you just wandered in from the desert. Who are you?",
