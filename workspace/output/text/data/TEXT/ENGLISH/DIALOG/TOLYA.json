    },
    {
      "occurrence": 12,
      "number": 104,
      "number_raw": "104",
      "source_number": "104",
      "audio": "",
      "source_audio": "",
      "text": "能告诉我你们营地的情况吗？",
      "source_text": "能告诉我你们营地的情况吗？",
      "source_line_start": 13,
      "source_line_end": 13,
