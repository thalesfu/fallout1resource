    },
    {
      "occurrence": 8,
      "number": 105,
      "number_raw": "105",
      "source_number": "105",
      "audio": "",
      "source_audio": "",
      "text": "I really like the new laser rifles, but the old laser pistols# are my favorite.",
      "source_text": "I really like the new laser rifles, but the old laser pistols\n# are my favorite.",
      "source_line_start": 10,
      "source_line_end": 11,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 9,
      "number": 106,
      "number_raw": "106",
      "source_number": "106",
      "audio": "",
      "source_audio": "",
      "text": "The night perimeter patrols are very dangerous. I wouldn't wander# too far at night if I were you.",
      "source_text": "The night perimeter patrols are very dangerous. I wouldn't wander\n# too far at night if I were you.",
      "source_line_start": 12,
