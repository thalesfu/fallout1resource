      "number": 109,
      "number_raw": "109",
      "source_number": "109",
      "audio": "",
      "source_audio": "",
      "text": "The Brotherhood is great. I haven't had any experience# outside of it, but it couldn't possibly get better than this.",
      "source_text": "The Brotherhood is great. I haven't had any experience\n# outside of it, but it couldn't possibly get better than this.",
