    },
    {
      "occurrence": 59,
      "number": 127,
      "number_raw": "127",
      "source_number": "127",
      "audio": "",
      "source_audio": "",
      "text": "A good group of people is what the Blades are.  Stuck ere between the damn Regulators and the #Deathclaws ain't meant the happiest life for em, but they survive.",
      "source_text": "A good group of people is what the Blades are.  Stuck ere between the damn Regulators and the \n#Deathclaws ain't meant the happiest life for em, but they survive.",
      "source_line_start": 96,
