      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 49,
      "number": 122,
      "number_raw": "122",
      "source_number": "122",
      "audio": "",
      "source_audio": "",
      "text": "I was thinkin the Deathclaws were the spawn of an unnatural act, but 'em Regulators are evil.  #Come once a month or so and they shows their ugly faces and drag a father away from is wee ones.",
      "source_text": "I was thinkin the Deathclaws were the spawn of an unnatural act, but 'em Regulators are evil.  \n#Come once a month or so and they shows their ugly faces and drag a father away from is wee ones.",
      "source_line_start": 80,
      "source_line_end": 81,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 50,
      "number": 122,
      "number_raw": "122",
      "source_number": "122",
      "audio": "",
      "source_audio": "",
      "text": "我之前一直认为死亡爪是非自然事件产生的物种，但是管理者，作为人类，他们却是一帮邪恶的混蛋。他们差不多每月来一次，到这里寻衅滋事，杀人害命，让弱小的孩子们失去父亲的保护。",
      "source_text": "我之前一直认为死亡爪是非自然事件产生的物种，但是管理者，作为人类，他们却是一帮邪恶的混蛋。他们差不多每月来一次，到这里寻衅滋事，杀人害命，让弱小的孩子们失去父亲的保护。",
      "source_line_start": 82,
      "source_line_end": 82,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
