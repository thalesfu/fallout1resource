    },
    {
      "occurrence": 3,
      "number": 100,
      "number_raw": "100",
      "source_number": "100",
      "audio": "",
      "source_audio": "",
      "text": "You see before you Uthern, leader of the Super Mutants.",
      "source_text": "You see before you Uthern, leader of the Super Mutants.",
      "source_line_start": 4,
      "source_line_end": 4,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 4,
      "number": 100,
      "number_raw": "100",
      "source_number": "100",
      "audio": "",
      "source_audio": "",
      "text": "站在你面前的是乌森，超级变种人的领袖。",
      "source_text": "站在你面前的是乌森，超级变种人的领袖。",
      "source_line_start": 5,
      "source_line_end": 5,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 5,
      "number": 101,
      "number_raw": "101",
      "source_number": "101",
      "audio": "",
      "source_audio": "",
      "text": "Normie! How dare you enter the confines of your betters?",
      "source_text": "Normie! How dare you enter the confines of your betters?",
      "source_line_start": 7,
      "source_line_end": 7,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 6,
      "number": 101,
      "number_raw": "101",
      "source_number": "101",
      "audio": "",
      "source_audio": "",
      "text": "正常人！你怎么敢进入高等人的地盘？",
      "source_text": "正常人！你怎么敢进入高等人的地盘？",
      "source_line_start": 8,
      "source_line_end": 8,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 7,
      "number": 102,
      "number_raw": "102",
      "source_number": "102",
      "audio": "",
      "source_audio": "",
      "text": "Huh?",
      "source_text": "Huh?",
      "source_line_start": 10,
      "source_line_end": 10,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 8,
      "number": 102,
      "number_raw": "102",
      "source_number": "102",
      "audio": "",
      "source_audio": "",
      "text": "唔？",
      "source_text": "唔？",
      "source_line_start": 11,
      "source_line_end": 11,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 9,
      "number": 103,
      "number_raw": "103",
      "source_number": "103",
      "audio": "",
      "source_audio": "",
      "text": "Scum like you could never be better than humans!",
      "source_text": "Scum like you could never be better than humans!",
      "source_line_start": 13,
      "source_line_end": 13,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 10,
      "number": 103,
      "number_raw": "103",
      "source_number": "103",
      "audio": "",
      "source_audio": "",
      "text": "你这人渣永远比不上人类！",
      "source_text": "你这人渣永远比不上人类！",
      "source_line_start": 14,
      "source_line_end": 14,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 11,
      "number": 104,
      "number_raw": "104",
      "source_number": "104",
      "audio": "",
      "source_audio": "",
      "text": "Die Mutie!!",
      "source_text": "Die Mutie!!",
      "source_line_start": 16,
      "source_line_end": 16,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 12,
      "number": 104,
      "number_raw": "104",
      "source_number": "104",
      "audio": "",
      "source_audio": "",
      "text": "去死，烂变种！！",
      "source_text": "去死，烂变种！！",
      "source_line_start": 17,
      "source_line_end": 17,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 13,
      "number": 105,
      "number_raw": "105",
      "source_number": "105",
      "audio": "",
      "source_audio": "",
      "text": "Really? You claim yourself better, but what proof do you have?",
      "source_text": "Really? You claim yourself better, but what proof do you have?",
      "source_line_start": 19,
      "source_line_end": 19,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 14,
      "number": 105,
      "number_raw": "105",
      "source_number": "105",
      "audio": "",
      "source_audio": "",
      "text": "真的？你认为你自己更好，但是你有什么证明？",
      "source_text": "真的？你认为你自己更好，但是你有什么证明？",
      "source_line_start": 20,
      "source_line_end": 20,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 15,
      "number": 106,
      "number_raw": "106",
      "source_number": "106",
      "audio": "",
      "source_audio": "",
      "text": "If you consider yourself one better than the rest, you run into the fallacy of over generalization.",
      "source_text": "If you consider yourself one better than the rest, you run into the fallacy of over generalization.",
      "source_line_start": 22,
      "source_line_end": 22,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 16,
      "number": 106,
      "number_raw": "106",
      "source_number": "106",
      "audio": "",
      "source_audio": "",
      "text": "假如你认为自己比别人更好，你就犯了以偏概全的错误。",
      "source_text": "假如你认为自己比别人更好，你就犯了以偏概全的错误。",
      "source_line_start": 23,
      "source_line_end": 23,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 17,
      "number": 107,
      "number_raw": "107",
      "source_number": "107",
      "audio": "",
      "source_audio": "",
      "text": "It's a wonder your race survived as long as it has. I will start with you in the cleansing.",
      "source_text": "It's a wonder your race survived as long as it has. I will start with you in the cleansing.",
      "source_line_start": 25,
      "source_line_end": 25,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 18,
      "number": 107,
      "number_raw": "107",
      "source_number": "107",
      "audio": "",
      "source_audio": "",
      "text": "你的种族存在这么久是个奇迹。我将以你的净化开始。",
      "source_text": "你的种族存在这么久是个奇迹。我将以你的净化开始。",
      "source_line_start": 26,
      "source_line_end": 26,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 19,
      "number": 108,
      "number_raw": "108",
      "source_number": "108",
      "audio": "",
      "source_audio": "",
      "text": "You only prove my point by using inane comments as such. I personally would not wish you in my sight, but my master would have words with you.",
      "source_text": "You only prove my point by using inane comments as such. I personally would not wish you in my sight, but my master would have words with you.",
      "source_line_start": 28,
      "source_line_end": 28,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 20,
      "number": 108,
      "number_raw": "108",
      "source_number": "108",
      "audio": "",
      "source_audio": "",
      "text": "你这样的疯话正好说明了我刚才所说的话是正确的。我本人真不想再看见你这副嘴脸，但我们的主教有话和你说。",
      "source_text": "你这样的疯话正好说明了我刚才所说的话是正确的。我本人真不想再看见你这副嘴脸，但我们的主教有话和你说。",
      "source_line_start": 29,
      "source_line_end": 29,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 21,
      "number": 109,
      "number_raw": "109",
      "source_number": "109",
      "audio": "",
      "source_audio": "",
      "text": "Show me your master.",
      "source_text": "Show me your master.",
      "source_line_start": 32,
      "source_line_end": 32,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 22,
      "number": 109,
      "number_raw": "109",
      "source_number": "109",
      "audio": "",
      "source_audio": "",
      "text": "带我见你们的主教。",
      "source_text": "带我见你们的主教。",
      "source_line_start": 33,
      "source_line_end": 33,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 23,
      "number": 110,
      "number_raw": "110",
      "source_number": "110",
      "audio": "",
      "source_audio": "",
      "text": "Try these words -- Drop dead!",
      "source_text": "Try these words -- Drop dead!",
      "source_line_start": 35,
      "source_line_end": 35,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 24,
      "number": 110,
      "number_raw": "110",
      "source_number": "110",
      "audio": "",
      "source_audio": "",
      "text": "那我就换个说法——你去死！",
      "source_text": "那我就换个说法——你去死！",
      "source_line_start": 36,
      "source_line_end": 36,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 25,
      "number": 111,
      "number_raw": "111",
      "source_number": "111",
      "audio": "",
      "source_audio": "",
      "text": "Surely one of your intellect can see that such things will solve nothing.",
      "source_text": "Surely one of your intellect can see that such things will solve nothing.",
      "source_line_start": 38,
      "source_line_end": 38,
