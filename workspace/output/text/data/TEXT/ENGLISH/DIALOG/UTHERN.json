      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 41,
      "number": 119,
      "number_raw": "119",
      "source_number": "119",
      "audio": "",
      "source_audio": "",
      "text": "The simplest of proofs for you. I am smarter, stronger, and quicker than you are. Would you care for a test of my skills?",
      "source_text": "The simplest of proofs for you. I am smarter, stronger, and quicker than you are. Would you care for a test of my skills?",
