      "number": 101,
      "number_raw": "101",
      "source_number": "101",
      "audio": "",
      "source_audio": "",
      "text": "I am Gwen. I'm one of Garl's advisors. Who are you?",
      "source_text": "I am Gwen. I'm one of Garl's advisors. Who are you?",
      "source_line_start": 5,
      "source_line_end": 5,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
