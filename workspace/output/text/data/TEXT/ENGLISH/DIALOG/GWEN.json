      "number_raw": "100",
      "source_number": "100",
      "audio": "",
      "source_audio": "",
      "text": "You see Gwen, a desert bandit.",
      "source_text": "You see Gwen, a desert bandit.",
      "source_line_start": 4,
      "source_line_end": 4,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
