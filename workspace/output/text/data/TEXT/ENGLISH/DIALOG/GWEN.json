      "source_text": "Die!",
      "source_line_start": 24,
      "source_line_end": 24,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 21,
      "number": 118,
      "number_raw": "118",
      "source_number": "118",
      "audio": "",
      "source_audio": "",
      "text": "It's been so long since I've had a good fight. Too bad# you are going to lose. Here is proof of my skills!",
      "source_text": "It's been so long since I've had a good fight. Too bad\n# you are going to lose. Here is proof of my skills!",
      "source_line_start": 25,
      "source_line_end": 26,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 22,
      "number": 119,
      "number_raw": "119",
      "source_number": "119",
      "audio": "",
      "source_audio": "",
      "text": "You'll regret that remark.  It will be your last!",
