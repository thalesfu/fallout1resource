      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 23,
      "number": 110,
      "number_raw": "110",
      "source_number": "110",
      "audio": "",
      "source_audio": "",
      "text": "Oh, sorry.",
      "source_text": "Oh, sorry.",
      "source_line_start": 25,
      "source_line_end": 25,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 24,
      "number": 110,
      "number_raw": "110",
      "source_number": "110",
      "audio": "",
      "source_audio": "",
