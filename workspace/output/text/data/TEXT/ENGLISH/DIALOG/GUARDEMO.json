    },
    {
      "occurrence": 20,
      "number": 108,
      "number_raw": "108",
      "source_number": "108",
      "audio": "",
      "source_audio": "",
      "text": "呃 哦。",
      "source_text": "呃 哦。",
      "source_line_start": 22,
      "source_line_end": 22,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 21,
      "number": 109,
      "number_raw": "109",
      "source_number": "109",
      "audio": "",
      "source_audio": "",
      "text": "Your weapon, idiot. Killian won't take your arms away, but you'd better damn well keep them in your holster.",
      "source_text": "Your weapon, idiot. Killian won't take your arms away, but you'd better damn well keep them in your holster.",
      "source_line_start": 23,
      "source_line_end": 23,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 22,
      "number": 109,
      "number_raw": "109",
      "source_number": "109",
      "audio": "",
      "source_audio": "",
      "text": "你的武器，白痴。基利安不会缴你的械，但是你最好把你的枪乖乖地收起来。",
      "source_text": "你的武器，白痴。基利安不会缴你的械，但是你最好把你的枪乖乖地收起来。",
      "source_line_start": 24,
