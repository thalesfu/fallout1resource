    },
    {
      "occurrence": 5,
      "number": 101,
      "number_raw": "101",
      "source_number": "101",
      "audio": "",
      "source_audio": "",
      "text": "This is Junktown. Nice place to live, as long as you stay on our good side",
      "source_text": "This is Junktown. Nice place to live, as long as you stay on our good side",
      "source_line_start": 6,
      "source_line_end": 6,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 6,
      "number": 101,
      "number_raw": "101",
      "source_number": "101",
      "audio": "",
      "source_audio": "",
      "text": "这里是迦克镇。如果你规矩点，这里就是一个很好的地方。",
      "source_text": "这里是迦克镇。如果你规矩点，这里就是一个很好的地方。",
      "source_line_start": 7,
      "source_line_end": 7,
