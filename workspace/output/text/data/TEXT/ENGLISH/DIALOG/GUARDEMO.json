      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 7,
      "number": 102,
      "number_raw": "102",
      "source_number": "102",
      "audio": "",
      "source_audio": "",
      "text": "Watch out for Gizmo and his cronies.",
      "source_text": "Watch out for Gizmo and his cronies.",
      "source_line_start": 8,
      "source_line_end": 8,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 8,
      "number": 102,
      "number_raw": "102",
      "source_number": "102",
      "audio": "",
      "source_audio": "",
      "text": "小心吉斯莫和他的人。",
      "source_text": "小心吉斯莫和他的人。",
      "source_line_start": 9,
      "source_line_end": 9,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 9,
      "number": 103,
      "number_raw": "103",
      "source_number": "103",
      "audio": "",
      "source_audio": "",
      "text": "I like my boss.",
      "source_text": "I like my boss.",
      "source_line_start": 10,
      "source_line_end": 10,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 10,
      "number": 103,
      "number_raw": "103",
      "source_number": "103",
      "audio": "",
      "source_audio": "",
      "text": "我喜欢我的老板。",
      "source_text": "我喜欢我的老板。",
      "source_line_start": 11,
      "source_line_end": 11,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 11,
      "number": 104,
      "number_raw": "104",
      "source_number": "104",
      "audio": "",
      "source_audio": "",
      "text": "You'd better put that away. Junktown is a friendly place, friend, and we want to keep it that way.",
      "source_text": "You'd better put that away. Junktown is a friendly place,\n friend, and we want to keep it that way.",
      "source_line_start": 12,
      "source_line_end": 13,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 12,
      "number": 104,
      "number_raw": "104",
      "source_number": "104",
      "audio": "",
      "source_audio": "",
      "text": "你最好把那个收起来。迦克镇是一个和平的地方，而且我们想这样继续下去。",
      "source_text": "你最好把那个收起来。迦克镇是一个和平的地方，而且我们想这样继续下去。",
      "source_line_start": 14,
      "source_line_end": 14,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 13,
      "number": 105,
      "number_raw": "105",
      "source_number": "105",
      "audio": "",
      "source_audio": "",
      "text": "Put what away?",
      "source_text": "Put what away?",
      "source_line_start": 15,
      "source_line_end": 15,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 14,
      "number": 105,
      "number_raw": "105",
      "source_number": "105",
      "audio": "",
      "source_audio": "",
      "text": "把什么收起来？",
      "source_text": "把什么收起来？",
      "source_line_start": 16,
      "source_line_end": 16,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 15,
      "number": 106,
      "number_raw": "106",
      "source_number": "106",
      "audio": "",
      "source_audio": "",
      "text": "Don't tell me what to do, loser boy.",
      "source_text": "Don't tell me what to do, loser boy.",
      "source_line_start": 17,
      "source_line_end": 17,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 16,
      "number": 106,
      "number_raw": "106",
      "source_number": "106",
      "audio": "",
      "source_audio": "",
      "text": "别让我动手，白痴。",
      "source_text": "别让我动手，白痴。",
      "source_line_start": 18,
      "source_line_end": 18,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 17,
      "number": 107,
      "number_raw": "107",
      "source_number": "107",
      "audio": "",
      "source_audio": "",
      "text": "Sounds fair. By the way, what is the local law regarding weapons?",
      "source_text": "Sounds fair. By the way, what is the local law regarding weapons?",
      "source_line_start": 19,
      "source_line_end": 19,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 18,
      "number": 107,
      "number_raw": "107",
      "source_number": "107",
      "audio": "",
      "source_audio": "",
      "text": "听起来挺合理。顺便问问，这儿关于武器的法律是什么？",
      "source_text": "听起来挺合理。顺便问问，这儿关于武器的法律是什么？",
      "source_line_start": 20,
      "source_line_end": 20,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 19,
      "number": 108,
      "number_raw": "108",
      "source_number": "108",
      "audio": "",
      "source_audio": "",
      "text": "Uh oh.",
      "source_text": "Uh oh.",
      "source_line_start": 21,
      "source_line_end": 21,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
