      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 20,
      "number": 108,
      "number_raw": "108",
      "source_number": "108",
      "audio": "",
      "source_audio": "",
      "text": "他在你最无法预料的时间和地点找到了你！赞美主教！赞美圣焰！赞美这世界！",
      "source_text": "他在你最无法预料的时间和地点找到了你！赞美主教！赞美圣焰！赞美这世界！",
      "source_line_start": 29,
