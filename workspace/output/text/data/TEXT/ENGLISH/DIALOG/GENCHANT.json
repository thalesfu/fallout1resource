    },
    {
      "occurrence": 5,
      "number": 101,
      "number_raw": "101",
      "source_number": "101",
      "audio": "",
      "source_audio": "",
      "text": "The Master will forgive your sins! Join us and be free! Praise to the Master and his mercy!",
      "source_text": "The Master will forgive your sins! Join us and be free! Praise to the Master and his mercy!",
      "source_line_start": 7,
      "source_line_end": 7,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 6,
      "number": 101,
      "number_raw": "101",
      "source_number": "101",
      "audio": "",
      "source_audio": "",
      "text": "主教会赦免你们的罪！加入我们，获得自由吧！赞美主教和他的仁慈！",
      "source_text": "主教会赦免你们的罪！加入我们，获得自由吧！赞美主教和他的仁慈！",
      "source_line_start": 8,
      "source_line_end": 8,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 7,
      "number": 102,
      "number_raw": "102",
      "source_number": "102",
      "audio": "",
      "source_audio": "",
      "text": "Hello friend! Will you sing a song of Praise with me? . . . Once I was wandering blind, In a land that was so unkind . . .",
      "source_text": "Hello friend! Will you sing a song of Praise with me? . . . Once I was wandering blind, In a land that was so unkind . . .",
      "source_line_start": 10,
      "source_line_end": 10,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 8,
      "number": 102,
      "number_raw": "102",
      "source_number": "102",
      "audio": "",
      "source_audio": "",
      "text": "好啊朋友！你可愿意与我同唱一曲赞歌？……我曾盲目漫游，在这严酷之地上……",
      "source_text": "好啊朋友！你可愿意与我同唱一曲赞歌？……我曾盲目漫游，在这严酷之地上……",
      "source_line_start": 11,
      "source_line_end": 11,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 9,
      "number": 103,
      "number_raw": "103",
      "source_number": "103",
      "audio": "",
      "source_audio": "",
      "text": "I hate to interrupt your hymn, but where might I meet the Master?",
      "source_text": "I hate to interrupt your hymn, but where might I meet the Master?",
      "source_line_start": 13,
      "source_line_end": 13,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 10,
      "number": 103,
      "number_raw": "103",
      "source_number": "103",
      "audio": "",
      "source_audio": "",
      "text": "我不喜欢打断你们咏唱赞美诗，但是我在哪里能见到主教？",
      "source_text": "我不喜欢打断你们咏唱赞美诗，但是我在哪里能见到主教？",
      "source_line_start": 14,
      "source_line_end": 14,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
