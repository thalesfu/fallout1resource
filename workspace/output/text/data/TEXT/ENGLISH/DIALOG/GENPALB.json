      "number": 127,
      "number_raw": "127",
      "source_number": "127",
      "audio": "",
      "source_audio": "",
      "text": "There are reports of large mutant humans attacking travelers, so we're# increasing our vigilance. Keep a close eye on the area and retreat to the# compound if necessary. Initiate, dismissed!",
      "source_text": "There are reports of large mutant humans attacking travelers, so we're\n# increasing our vigilance. Keep a close eye on the area and retreat to the\n# compound if necessary. Initiate, dismissed!",
      "source_line_start": 57,
