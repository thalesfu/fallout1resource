      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 54,
      "number": 122,
      "number_raw": "122",
      "source_number": "122",
      "audio": "",
      "source_audio": "",
      "text": "闭嘴，你这个新兵蛋子。",
