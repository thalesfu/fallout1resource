    },
    {
      "occurrence": 49,
      "number": 128,
      "number_raw": "128",
      "source_number": "128",
      "audio": "",
      "source_audio": "",
      "text": "These are troubled times, Initiate! Mutants are on the march, attacking# caravans! We need information, and we need it now! Nothing to report is not# good enough!",
      "source_text": "These are troubled times, Initiate! Mutants are on the march, attacking\n# caravans! We need information, and we need it now! Nothing to report is not\n# good enough!",
      "source_line_start": 60,
      "source_line_end": 62,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 50,
      "number": 118,
