      "number_raw": "130",
      "source_number": "130",
      "audio": "",
      "source_audio": "",
      "text": "You are too strong for me, and I am tired by many days in the wastes. I do# not wish to die. Though it shames me, I surrender.",
      "source_text": "You are too strong for me, and I am tired by many days in the wastes. I do\n# not wish to die. Though it shames me, I surrender.",
