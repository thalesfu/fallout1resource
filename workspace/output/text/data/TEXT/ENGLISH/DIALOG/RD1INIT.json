      "effective": false
    },
    {
      "occurrence": 12,
      "number": 109,
      "number_raw": "109",
      "source_number": "109",
      "audio": "",
      "source_audio": "",
      "text": "Yea, being a Knight would be great, they see lots of action and# get to build all the stuff. I haven't decided yet, but I'm leaning# towards a Knight myself. Am I boring you? Some people say I talk a lot# but I just don't think they understand. I just have a lot to say.",
      "source_text": "Yea, being a Knight would be great, they see lots of action and\n# get to build all the stuff. I haven't decided yet, but I'm leaning\n# towards a Knight myself. Am I boring you? Some people say I talk a lot\n# but I just don't think they understand. I just have a lot to say.",
      "source_line_start": 15,
      "source_line_end": 18,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 13,
      "number": 110,
      "number_raw": "110",
      "source_number": "110",
      "audio": "",
      "source_audio": "",
      "text": "No, not at all.",
      "source_text": "No, not at all.",
      "source_line_start": 19,
      "source_line_end": 19,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 14,
      "number": 111,
      "number_raw": "111",
      "source_number": "111",
      "audio": "",
      "source_audio": "",
      "text": "I've got to go. Nice meeting you.",
      "source_text": "I've got to go. Nice meeting you.",
      "source_line_start": 20,
      "source_line_end": 20,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 15,
      "number": 112,
      "number_raw": "112",
      "source_number": "112",
      "audio": "",
      "source_audio": "",
      "text": "Yea, Scribes have such a creative position. It would be great# to think up new weapons, modify old ones, and keep records of every # detail of every item in the Brotherhood. Am I boring you? Some people# say I talk a lot but I just don't think they understand. I just have# a lot to say.",
      "source_text": "Yea, Scribes have such a creative position. It would be great\n# to think up new weapons, modify old ones, and keep records of every \n# detail of every item in the Brotherhood. Am I boring you? Some people\n# say I talk a lot but I just don't think they understand. I just have\n# a lot to say.",
      "source_line_start": 21,
      "source_line_end": 25,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 16,
      "number": 113,
      "number_raw": "113",
      "source_number": "113",
      "audio": "",
      "source_audio": "",
      "text": "Yea, I'm still trying to decide. It's so tough, they're both# really exciting. By the way, if you want the top bunk just let me# know, I don't mind.",
      "source_text": "Yea, I'm still trying to decide. It's so tough, they're both\n# really exciting. By the way, if you want the top bunk just let me\n# know, I don't mind.",
      "source_line_start": 26,
      "source_line_end": 28,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 17,
