      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 18,
      "number": 115,
      "number_raw": "115",
      "source_number": "115",
      "audio": "",
      "source_audio": "",
      "text": "Are you all right? Maybe you need to see the doctor or maybe# you just need some sleep. Well I better get back to studying.  Bye.",
      "source_text": "Are you all right? Maybe you need to see the doctor or maybe\n# you just need some sleep. Well I better get back to studying.  Bye.",
