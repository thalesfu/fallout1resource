      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 19,
      "number": 116,
      "number_raw": "116",
      "source_number": "116",
      "audio": "",
      "source_audio": "",
      "text": "Oh, by the way, I'm glad you'll be my new roommate. My last# one always wore ear plugs, I don't know why. Anyhow, feel free to# leave anything you like here, I don't take up much space. Do you want# the top bunk? I'll change if you want... you don't snore do you? Oh,# it doesn't matter. See ya.",
      "source_text": "Oh, by the way, I'm glad you'll be my new roommate. My last\n# one always wore ear plugs, I don't know why. Anyhow, feel free to\n# leave anything you like here, I don't take up much space. Do you want\n# the top bunk? I'll change if you want... you don't snore do you? Oh,\n# it doesn't matter. See ya.",
      "source_line_start": 32,
