    },
    {
      "occurrence": 8,
      "number": 103,
      "number_raw": "103",
      "source_number": "103",
      "audio": "",
      "source_audio": "",
      "text": "没关系，我很高兴我能帮上忙。",
      "source_text": "没关系，我很高兴我能帮上忙。",
      "source_line_start": 13,
      "source_line_end": 13,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
