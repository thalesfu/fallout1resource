    {
      "occurrence": 3,
      "number": 101,
      "number_raw": "101",
      "source_number": "101",
      "audio": "",
      "source_audio": "",
      "text": "Thank you stranger! I don't know how many weeks, perhaps months, those thugs have# had me here. I'm very grateful for your help, and I'm sure the Brotherhood of Steel is also.",
      "source_text": "Thank you stranger! I don't know how many weeks, perhaps months, those thugs have\n# had me here. I'm very grateful for your help, and I'm sure the Brotherhood of Steel is also.",
      "source_line_start": 5,
      "source_line_end": 6,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 4,
      "number": 101,
      "number_raw": "101",
      "source_number": "101",
      "audio": "",
      "source_audio": "",
      "text": "谢谢你陌生人！我已经不知道过了几个礼拜了，大概有一个月了，那些恶棍一直在囚禁我。对你的帮助我感激不尽，钢铁兄弟会也会同样感激你的。",
      "source_text": "谢谢你陌生人！我已经不知道过了几个礼拜了，大概有一个月了，那些恶棍一直在囚禁我。对你的帮助我感激不尽，钢铁兄弟会也会同样感激你的。",
      "source_line_start": 7,
      "source_line_end": 7,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
