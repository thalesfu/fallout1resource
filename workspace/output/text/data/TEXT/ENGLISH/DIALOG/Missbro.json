      "effective": true
    },
    {
      "occurrence": 13,
      "number": 106,
      "number_raw": "106",
      "source_number": "106",
      "audio": "",
      "source_audio": "",
      "text": "You're welcome. Bye.",
      "source_text": "You're welcome. Bye.",
      "source_line_start": 21,
