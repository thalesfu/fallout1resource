      "source_text": "Are you going to be okay?",
      "source_line_start": 15,
      "source_line_end": 15,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 10,
      "number": 104,
      "number_raw": "104",
      "source_number": "104",
      "audio": "",
      "source_audio": "",
      "text": "你还好吗？",
      "source_text": "你还好吗？",
      "source_line_start": 16,
      "source_line_end": 16,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 11,
      "number": 105,
      "number_raw": "105",
      "source_number": "105",
      "audio": "",
      "source_audio": "",
      "text": "I'm from the Brotherhood. I've been looking for you.",
      "source_text": "I'm from the Brotherhood. I've been looking for you.",
      "source_line_start": 18,
      "source_line_end": 18,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 12,
      "number": 105,
      "number_raw": "105",
      "source_number": "105",
      "audio": "",
      "source_audio": "",
      "text": "我来自钢铁兄弟会。我一直在找你。",
      "source_text": "我来自钢铁兄弟会。我一直在找你。",
      "source_line_start": 19,
