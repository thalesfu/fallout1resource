    {
      "occurrence": 7,
      "number": 103,
      "number_raw": "103",
      "source_number": "103",
      "audio": "",
      "source_audio": "",
      "text": "Well, I'm glad that I could help.",
      "source_text": "Well, I'm glad that I could help.",
      "source_line_start": 12,
      "source_line_end": 12,
      "number_occurrence": 1,
