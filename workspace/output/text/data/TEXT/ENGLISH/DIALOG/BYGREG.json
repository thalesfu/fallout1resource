    },
    {
      "occurrence": 20,
      "number": 108,
      "number_raw": "108",
      "source_number": "108",
      "audio": "",
      "source_audio": "",
      "text": "别介意。",
      "source_text": "别介意。",
      "source_line_start": 21,
      "source_line_end": 21,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 21,
      "number": 109,
      "number_raw": "109",
      "source_number": "109",
      "audio": "",
      "source_audio": "",
      "text": "I'm...Greg...but don't let anyone else know, or they'll come find me.",
      "source_text": "I'm...Greg...but don't let anyone else know, or they'll come find me.",
      "source_line_start": 22,
      "source_line_end": 22,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 22,
      "number": 109,
      "number_raw": "109",
      "source_number": "109",
      "audio": "",
      "source_audio": "",
      "text": "我是……格雷格……但是不要让别人知道，不然他们会来找我的。",
      "source_text": "我是……格雷格……但是不要让别人知道，不然他们会来找我的。",
      "source_line_start": 23,
      "source_line_end": 23,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 23,
      "number": 110,
      "number_raw": "110",
      "source_number": "110",
      "audio": "",
      "source_audio": "",
      "text": "Jumpy, I'm not jumpy.  Just careful.  They all say I'm paranoid, but I'm the one that's gonna be here when they come to get us.",
      "source_text": "Jumpy, I'm not jumpy.  Just careful.  They all say I'm paranoid, but I'm the one that's gonna be here when they come to get us.",
      "source_line_start": 24,
      "source_line_end": 24,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 24,
      "number": 110,
      "number_raw": "110",
      "source_number": "110",
      "audio": "",
      "source_audio": "",
      "text": "神经质，我不是神经质。我只是谨慎。他们都说我是妄想狂，但我只是他们来抓我们的时候碰巧在那而已。",
      "source_text": "神经质，我不是神经质。我只是谨慎。他们都说我是妄想狂，但我只是他们来抓我们的时候碰巧在那而已。",
      "source_line_start": 25,
      "source_line_end": 25,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 25,
      "number": 111,
      "number_raw": "111",
      "source_number": "111",
      "audio": "",
      "source_audio": "",
      "text": "Come to get you?  Who is coming to get you?",
      "source_text": "Come to get you?  Who is coming to get you?",
      "source_line_start": 26,
      "source_line_end": 26,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
