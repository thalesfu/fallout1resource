      "source_number": "108",
      "audio": "",
      "source_audio": "",
      "text": "Never mind.",
      "source_text": "Never mind.",
      "source_line_start": 20,
      "source_line_end": 20,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
