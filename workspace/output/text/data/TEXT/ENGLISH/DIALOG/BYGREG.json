      "number_raw": "105",
      "source_number": "105",
      "audio": "",
      "source_audio": "",
      "text": "Who are you?",
      "source_text": "Who are you?",
      "source_line_start": 14,
      "source_line_end": 14,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 14,
