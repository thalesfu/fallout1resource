      "number_raw": "105",
      "source_number": "105",
      "audio": "",
      "source_audio": "",
      "text": "你是谁？",
      "source_text": "你是谁？",
      "source_line_start": 15,
      "source_line_end": 15,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 15,
      "number": 106,
      "number_raw": "106",
      "source_number": "106",
      "audio": "",
      "source_audio": "",
      "text": "Why are you so jumpy?",
      "source_text": "Why are you so jumpy?",
      "source_line_start": 16,
      "source_line_end": 16,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 16,
      "number": 106,
      "number_raw": "106",
      "source_number": "106",
      "audio": "",
      "source_audio": "",
      "text": "你为什么这么神经质？",
      "source_text": "你为什么这么神经质？",
      "source_line_start": 17,
      "source_line_end": 17,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
      "occurrence": 17,
      "number": 107,
      "number_raw": "107",
      "source_number": "107",
      "audio": "",
      "source_audio": "",
      "text": "I think they need to up your medication.",
      "source_text": "I think they need to up your medication.",
      "source_line_start": 18,
      "source_line_end": 18,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
      "occurrence": 18,
      "number": 107,
      "number_raw": "107",
      "source_number": "107",
      "audio": "",
      "source_audio": "",
      "text": "我认为他们需要加强你的药物治疗。",
      "source_text": "我认为他们需要加强你的药物治疗。",
      "source_line_start": 19,
      "source_line_end": 19,
      "number_occurrence": 2,
      "number_occurrence_count": 2,
      "effective": true
    },
    {
