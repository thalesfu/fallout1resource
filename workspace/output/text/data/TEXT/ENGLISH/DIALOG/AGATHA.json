    {
      "occurrence": 13,
      "number": 112,
      "number_raw": "112",
      "source_number": "112",
      "audio": "",
      "source_audio": "",
      "text": "我很想帮忙。",
      "source_text": "我很想帮忙。",
      "source_line_start": 13,
      "source_line_end": 13,
      "number_occurrence": 1,
      "number_occurrence_count": 2,
      "effective": false
    },
    {
