      "effective": false
    },
    {
      "occurrence": 17,
      "number": 116,
      "number_raw": "116",
      "source_number": "116",
      "audio": "",
      "source_audio": "",
      "text": "你不该这么粗鲁。现在道歉，不然我不会再教你。",
