    {
      "occurrence": 12,
      "number": 111,
      "number_raw": "111",
      "source_number": "111",
      "audio": "",
      "source_audio": "",
      "text": "Por las caravanas desaparecidas. No les sobra ninguno. Los utilizan casi todos. Las que quedan se cambian por comida. Pero debería dejar de hablar. Dan se va a enfadar si me ve hablar con un desconocido.",
      "source_text": "Por las caravanas desaparecidas. No les sobra ninguno. Los utilizan casi todos.\n Las que quedan se cambian por comida. Pero debería dejar de hablar. Dan se va a enfadar si me ve hablar con un\n desconocido.",
      "source_line_start": 13,
      "source_line_end": 15,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 13,
