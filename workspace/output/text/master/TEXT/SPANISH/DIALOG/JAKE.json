    {
      "occurrence": 8,
      "number": 107,
      "number_raw": "107",
      "source_number": "107",
      "audio": "",
      "source_audio": "",
      "text": "You want to help. I don't think you are good enough to help me out. Go talk to Neil.",
      "source_text": "You want to help. I don't think you are good enough to\n help me out. Go talk to Neil.",
      "source_line_start": 8,
      "source_line_end": 9,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 9,
      "number": 108,
      "number_raw": "108",
      "source_number": "108",
      "audio": "",
      "source_audio": "",
      "text": "I would love to fight you, but I am much too busy helping Nicole right now.",
      "source_text": "I would love to fight you, but I am much too busy helping\n Nicole right now.",
      "source_line_start": 10,
      "source_line_end": 11,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
