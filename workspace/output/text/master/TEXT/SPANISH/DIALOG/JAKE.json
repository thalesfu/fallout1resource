      "number": 112,
      "number_raw": "112",
      "source_number": "112",
      "audio": "",
      "source_audio": "",
      "text": "Hey. Just because I don't want to fight doesn't mean I'm a wimp. I just don't feel like it.",
      "source_text": "Hey. Just because I don't want to fight doesn't mean I'm a\n wimp. I just don't feel like it.",
      "source_line_start": 15,
      "source_line_end": 16,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
