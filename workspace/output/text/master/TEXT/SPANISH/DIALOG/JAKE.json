      "number": 109,
      "number_raw": "109",
      "source_number": "109",
      "audio": "",
      "source_audio": "",
      "text": "Figures. You looked like a wimp to me anyways.",
      "source_text": "Figures. You looked like a wimp to me anyways.",
      "source_line_start": 12,
      "source_line_end": 12,
      "number_occurrence": 1,
