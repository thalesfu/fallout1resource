      "number": 109,
      "number_raw": "109",
      "source_number": "109",
      "audio": "",
      "source_audio": "",
      "text": "¡Machacamos a los preguntones como tú!",
      "source_text": "¡Machacamos a los preguntones como tú!",
      "source_line_start": 11,
      "source_line_end": 11,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 11,
      "number": 110,
      "number_raw": "110",
      "source_number": "110",
      "audio": "",
      "source_audio": "",
      "text": "¡No tan rápido! Nadie entra en nuestro local sin pagar la tasa del dolor.",
      "source_text": "¡No tan rápido! Nadie entra en nuestro local sin pagar la tasa del dolor.",
      "source_line_start": 12,
      "source_line_end": 12,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 12,
      "number": 111,
      "number_raw": "111",
      "source_number": "111",
      "audio": "",
      "source_audio": "",
      "text": "Creo que tú servirás. Chicos, agarradla.",
      "source_text": "Creo que tú servirás. Chicos, agarradla.",
      "source_line_start": 13,
      "source_line_end": 13,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 13,
      "number": 112,
      "number_raw": "112",
      "source_number": "112",
      "audio": "",
      "source_audio": "",
