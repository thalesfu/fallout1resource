      "number": 105,
      "number_raw": "105",
      "source_number": "105",
      "audio": "",
      "source_audio": "",
      "text": "¿Qué hacéis para divertiros por aquí?",
      "source_text": "¿Qué hacéis para divertiros por aquí?",
      "source_line_start": 7,
      "source_line_end": 7,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 7,
      "number": 106,
      "number_raw": "106",
      "source_number": "106",
      "audio": "",
      "source_audio": "",
      "text": "Uh, ya me iba. Adios.",
      "source_text": "Uh, ya me iba. Adios.",
      "source_line_start": 8,
      "source_line_end": 8,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 8,
      "number": 107,
      "number_raw": "107",
      "source_number": "107",
      "audio": "",
      "source_audio": "",
      "text": "Quería echar un trago y . . . divertirme un poco.",
      "source_text": "Quería echar un trago y . . . divertirme un poco.",
      "source_line_start": 9,
      "source_line_end": 9,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 9,
      "number": 108,
      "number_raw": "108",
      "source_number": "108",
      "audio": "",
      "source_audio": "",
