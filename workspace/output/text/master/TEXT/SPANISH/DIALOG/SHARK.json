      "number_raw": "119",
      "source_number": "119",
      "audio": "",
      "source_audio": "",
      "text": "Ah, so perdedor. Corre con tu mamá.",
      "source_text": "Ah, so perdedor. Corre con tu mamá.",
      "source_line_start": 22,
      "source_line_end": 22,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
