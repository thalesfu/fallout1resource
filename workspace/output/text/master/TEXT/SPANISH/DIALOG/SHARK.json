      "number": 121,
      "number_raw": "121",
      "source_number": "121",
      "audio": "",
      "source_audio": "",
      "text": "Sólo quería echar un trago rápido.",
      "source_text": "Sólo quería echar un trago rápido.",
      "source_line_start": 24,
      "source_line_end": 24,
