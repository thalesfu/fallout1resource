    },
    {
      "occurrence": 4,
      "number": 103,
      "number_raw": "103",
      "source_number": "103",
      "audio": "",
      "source_audio": "",
      "text": "¡Eh, Carnaza! ¿Qué te trae a nuestro territorio, bocadito? ¿Buscando diversión? A tu costa, claro.",
      "source_text": "¡Eh, Carnaza! ¿Qué te trae a nuestro territorio, bocadito?\n ¿Buscando diversión? A tu costa, claro.",
