      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 19,
      "number": 118,
      "number_raw": "118",
      "source_number": "118",
      "audio": "",
      "source_audio": "",
      "text": "Nah, preferiría comer algo . . . ¡quizás tiburón a la parilla!",
      "source_text": "Nah, preferiría comer algo . . . ¡quizás tiburón a la parilla!",
      "source_line_start": 21,
