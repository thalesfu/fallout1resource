      "source_text": "Te presento al recaudador. ¡Se llama Sr. Martillazo!",
      "source_line_start": 14,
      "source_line_end": 14,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
