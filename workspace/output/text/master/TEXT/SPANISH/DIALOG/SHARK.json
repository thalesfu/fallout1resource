      "source_text": "¡No creo!",
      "source_line_start": 15,
      "source_line_end": 15,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 15,
      "number": 114,
      "number_raw": "114",
      "source_number": "114",
      "audio": "",
      "source_audio": "",
      "text": "Para entretenernos esta noche, ¡hemos decidido dar algunas palizas! Je. Agarra lo que puedas y corre como el diablo, ¿eh?",
      "source_text": "Para entretenernos esta noche, ¡hemos decidido dar algunas palizas!\n Je. Agarra lo que puedas y corre como el diablo, ¿eh?",
