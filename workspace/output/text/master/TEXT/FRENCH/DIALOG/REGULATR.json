      "number_raw": "126",
      "source_number": "126",
      "audio": "",
      "source_audio": "",
      "text": "Termine ton travail.",
      "source_text": "Termine ton travail.",
      "source_line_start": 27,
      "source_line_end": 27,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
