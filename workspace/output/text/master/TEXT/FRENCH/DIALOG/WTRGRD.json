    },
    {
      "occurrence": 7,
      "number": 106,
      "number_raw": "106",
      "source_number": "106",
      "audio": "",
      "source_audio": "",
      "text": "Oup.",
      "source_text": "Oup.",
      "source_line_start": 7,
