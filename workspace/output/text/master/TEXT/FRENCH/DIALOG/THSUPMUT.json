      "source_number": "122",
      "audio": "",
      "source_audio": "",
      "text": "Forget it.",
      "source_text": "Forget it.",
      "source_line_start": 24,
      "source_line_end": 24,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 24,
      "number": 123,
      "number_raw": "123",
      "source_number": "123",
      "audio": "",
      "source_audio": "",
      "text": "Something doesn't sound right about this.",
      "source_text": "Something doesn't sound right about this.",
      "source_line_start": 25,
      "source_line_end": 25,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 25,
      "number": 124,
      "number_raw": "124",
      "source_number": "124",
      "audio": "",
      "source_audio": "",
      "text": "Everything is perfectly fine. Perhaps it is the limited scope of your cranium which deters your advancement in thought.",
      "source_text": "Everything is perfectly fine. Perhaps it is the limited scope of your cranium which deters your\n advancement in thought.",
      "source_line_start": 26,
      "source_line_end": 27,
      "number_occurrence": 1,
