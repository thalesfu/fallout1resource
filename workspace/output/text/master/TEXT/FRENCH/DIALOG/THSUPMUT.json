    {
      "occurrence": 15,
      "number": 114,
      "number_raw": "114",
      "source_number": "114",
      "audio": "",
      "source_audio": "",
      "text": "Why would I wish to assist you?",
      "source_text": "Why would I wish to assist you?",
      "source_line_start": 15,
      "source_line_end": 15,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 16,
      "number": 115,
      "number_raw": "115",
      "source_number": "115",
      "audio": "",
      "source_audio": "",
      "text": "No matter simple one. Come with me, and I shall take you to the job.",
      "source_text": "No matter simple one. Come with me, and I shall take you to the job.",
      "source_line_start": 16,
      "source_line_end": 16,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 17,
      "number": 116,
      "number_raw": "116",
      "source_number": "116",
      "audio": "",
      "source_audio": "",
      "text": "That was not a request. Your presence will be made.",
      "source_text": "That was not a request. Your presence will be made.",
      "source_line_start": 17,
      "source_line_end": 17,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 18,
      "number": 117,
      "number_raw": "117",
      "source_number": "117",
      "audio": "",
      "source_audio": "",
      "text": "Are you not the one who seeks to bring peace to the wastelands?",
      "source_text": "Are you not the one who seeks to bring peace to the wastelands?",
      "source_line_start": 18,
      "source_line_end": 18,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 19,
      "number": 118,
      "number_raw": "118",
      "source_number": "118",
      "audio": "",
      "source_audio": "",
      "text": "Yes, however, I don't see how in aiding you how that will happen.",
      "source_text": "Yes, however, I don't see how in aiding you how that will happen.",
      "source_line_start": 19,
      "source_line_end": 19,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 20,
      "number": 119,
      "number_raw": "119",
      "source_number": "119",
      "audio": "",
      "source_audio": "",
      "text": "No. I prefer mass destruction.",
      "source_text": "No. I prefer mass destruction.",
      "source_line_start": 20,
      "source_line_end": 20,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 21,
      "number": 120,
      "number_raw": "120",
      "source_number": "120",
      "audio": "",
      "source_audio": "",
      "text": "We believe that if everyone, mutants and humans, could learn to work together, then a great many problems could be resolved.",
      "source_text": "We believe that if everyone, mutants and humans, could learn to work together, then a great\n many problems could be resolved.",
      "source_line_start": 21,
      "source_line_end": 22,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 22,
      "number": 121,
      "number_raw": "121",
      "source_number": "121",
      "audio": "",
      "source_audio": "",
      "text": "Sounds promising. Count me in.",
      "source_text": "Sounds promising. Count me in.",
      "source_line_start": 23,
      "source_line_end": 23,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
