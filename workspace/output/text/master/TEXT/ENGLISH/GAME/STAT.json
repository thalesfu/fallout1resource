    {
      "occurrence": 39,
      "number": 200,
      "number_raw": "200",
      "source_number": "200",
      "audio": "",
      "source_audio": "",
      "text": "Raw physical strength. A high Strength is good for physical characters. Modifies: Hit Points, Melee Damage, and Carry Weight.",
      "source_text": "Raw physical strength. A high Strength is good for physical characters. Modifies: Hit Points, Melee Damage, and Carry Weight.",
      "source_line_start": 51,
      "source_line_end": 51,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 40,
      "number": 201,
      "number_raw": "201",
      "source_number": "201",
      "audio": "",
      "source_audio": "",
      "text": "The ability to see, hear, taste and notice unusual things. A high Perception is important for a sharpshooter.  Modifies: Sequence and ranged combat distance modifiers.",
      "source_text": "The ability to see, hear, taste and notice unusual things. A high Perception is important for a sharpshooter.  Modifies: Sequence and ranged combat distance modifiers.",
      "source_line_start": 53,
      "source_line_end": 53,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 41,
      "number": 202,
      "number_raw": "202",
      "source_number": "202",
      "audio": "",
      "source_audio": "",
      "text": "Stamina and physical toughness. A character with a high Endurance will survive where others may not. Modifies: Hit Points, Poison & Radiation Resistance, Healing Rate, and the additional hit points per level.",
      "source_text": "Stamina and physical toughness. A character with a high Endurance will survive where others may not. Modifies: Hit Points, Poison & Radiation Resistance, Healing Rate, and the additional hit points per level.",
      "source_line_start": 55,
      "source_line_end": 55,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 42,
      "number": 203,
      "number_raw": "203",
      "source_number": "203",
      "audio": "",
      "source_audio": "",
      "text": "A combination of appearance and charm. A high Charisma is important for characters that want to influence people with words. Modifies: NPC reactions, and barter prices.",
      "source_text": "A combination of appearance and charm. A high Charisma is important for characters that want to influence people with words. Modifies: NPC reactions, and barter prices.",
      "source_line_start": 57,
      "source_line_end": 57,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 43,
      "number": 204,
      "number_raw": "204",
      "source_number": "204",
      "audio": "",
      "source_audio": "",
      "text": "Knowledge, wisdom and the ability to think quickly. A high Intelligence is important for any character. Modifies: the number of new skill points per level, dialogue options, and many skills.",
      "source_text": "Knowledge, wisdom and the ability to think quickly. A high Intelligence is important for any character. Modifies: the number of new skill points per level, dialogue options, and many skills.",
      "source_line_start": 59,
      "source_line_end": 59,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 44,
      "number": 205,
      "number_raw": "205",
      "source_number": "205",
      "audio": "",
      "source_audio": "",
      "text": "Coordination and the ability to move well. A high Agility is important for any active character. Modifies: Action Points, Armor Class, Sequence, and many skills.",
      "source_text": "Coordination and the ability to move well. A high Agility is important for any active character. Modifies: Action Points, Armor Class, Sequence, and many skills.",
      "source_line_start": 61,
      "source_line_end": 61,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 45,
      "number": 206,
      "number_raw": "206",
      "source_number": "206",
      "audio": "",
      "source_audio": "",
      "text": "Fate. Karma. An extremely high or low Luck will affect the character - somehow. Events and situations will be changed by how lucky (or unlucky) your character is.",
      "source_text": "Fate. Karma. An extremely high or low Luck will affect the character - somehow. Events and situations will be changed by how lucky (or unlucky) your character is.",
      "source_line_start": 63,
      "source_line_end": 63,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
