      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 24,
      "number": 123,
      "number_raw": "123",
      "source_number": "123",
      "audio": "",
      "source_audio": "",
      "text": "You want to whack Killian? Man, you're crazy. Man, I don't know . . . all right, I'm in.",
      "source_text": "You want to whack Killian? Man, you're crazy. Man, I don't know . . .\n all right, I'm in.",
