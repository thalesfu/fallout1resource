      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 29,
      "number": 128,
      "number_raw": "128",
      "source_number": "128",
      "audio": "",
      "source_audio": "",
      "text": "I'm looking for someone to help me take out Killian. The Skulz seemed like a good prospect.",
      "source_text": "I'm looking for someone to help me take out Killian. The Skulz seemed like\n a good prospect.",
      "source_line_start": 40,
