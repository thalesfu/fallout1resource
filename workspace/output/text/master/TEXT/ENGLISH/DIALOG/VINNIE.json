      "number": 102,
      "number_raw": "102",
      "source_number": "102",
      "audio": "",
      "source_audio": "",
      "text": "I'd like to join you guys.",
      "source_text": "I'd like to join you guys.",
      "source_line_start": 8,
      "source_line_end": 8,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
