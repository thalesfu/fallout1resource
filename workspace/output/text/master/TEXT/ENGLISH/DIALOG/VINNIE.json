      "number": 129,
      "number_raw": "129",
      "source_number": "129",
      "audio": "",
      "source_audio": "",
      "text": "Damn, I didn't think you'd do it! The Skulz rule this town now! Woo!",
      "source_text": "Damn, I didn't think you'd do it! The Skulz rule this town now! Woo!",
      "source_line_start": 42,
