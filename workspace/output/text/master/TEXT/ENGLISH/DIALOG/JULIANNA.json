      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 14,
      "number": 113,
      "number_raw": "113",
      "source_number": "113",
      "audio": "",
      "source_audio": "",
      "text": "Well, Miles does chemistry, and he makes bullets and things. Smitty is a craftsman who builds things like pots and knives.",
      "source_text": "Well, Miles does chemistry, and he makes bullets and things.\n Smitty is a craftsman who builds things like pots and knives.",
      "source_line_start": 16,
