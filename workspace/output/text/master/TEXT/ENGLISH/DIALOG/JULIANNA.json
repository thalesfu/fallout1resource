    {
      "occurrence": 11,
      "number": 110,
      "number_raw": "110",
      "source_number": "110",
      "audio": "",
      "source_audio": "",
      "text": "I do what Caleb asks. But I am really only able to do a little farming. I don't have the skills to help Smitty or Miles out.",
      "source_text": "I do what Caleb asks. But I am really only able to do a little farming.\n I don't have the skills to help Smitty or Miles out.",
