      "number_raw": "112",
      "source_number": "112",
      "audio": "",
      "source_audio": "",
      "text": "We survive, and the Regulators make sure that nothing happens to hurt us. Mostly by not letting us out of here.",
      "source_text": "We survive, and the Regulators make sure that nothing happens to hurt us.\n Mostly by not letting us out of here.",
      "source_line_start": 14,
