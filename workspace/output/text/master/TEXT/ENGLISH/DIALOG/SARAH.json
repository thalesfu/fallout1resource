      "number": 104,
      "number_raw": "104",
      "source_number": "104",
      "audio": "",
      "source_audio": "",
      "text": "I'm sorry. I didn't know that he was so close to you.",
      "source_text": "I'm sorry. I didn't know that he was so close to you.",
      "source_line_start": 5,
      "source_line_end": 5,
