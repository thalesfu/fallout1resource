      "number_raw": "105",
      "source_number": "105",
      "audio": "",
      "source_audio": "",
      "text": "You didn't have to kill him! [Sarah sobs.] Leave me alone.",
      "source_text": "You didn't have to kill him! [Sarah sobs.] Leave me alone.",
