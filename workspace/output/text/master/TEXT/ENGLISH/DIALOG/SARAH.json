    {
      "occurrence": 8,
      "number": 107,
      "number_raw": "107",
      "source_number": "107",
      "audio": "",
      "source_audio": "",
      "text": "Again, I apologize. How could I tell that he meant so much to you? Look at him. He's a mutant.",
