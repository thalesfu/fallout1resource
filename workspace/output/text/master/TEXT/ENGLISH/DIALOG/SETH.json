      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 3,
      "number": 102,
      "number_raw": "102",
      "source_number": "102",
      "audio": "",
      "source_audio": "",
      "text": "Nothing good comes of your kind. I will kill you and rid the wasteland of one more monster.",
      "source_text": "Nothing good comes of your kind. I will kill you and\n rid the wasteland of one more monster.",
      "source_line_start": 4,
