      "number_raw": "101",
      "source_number": "101",
      "audio": "",
      "source_audio": "",
      "text": "You! You've plagued our village for long enough. I'll kill you myself!",
      "source_text": "You! You've plagued our village for long enough.\n I'll kill you myself!",
      "source_line_start": 2,
      "source_line_end": 3,
