    },
    {
      "occurrence": 9,
      "number": 108,
      "number_raw": "108",
      "source_number": "108",
      "audio": "",
      "source_audio": "",
      "text": "Oh, great. You don't know how gratified that makes me. Go away.",
      "source_text": "Oh, great. You don't know how gratified that makes me. Go away.",
      "source_line_start": 9,
      "source_line_end": 9,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 10,
      "number": 109,
      "number_raw": "109",
      "source_number": "109",
      "audio": "",
      "source_audio": "",
      "text": "Thanks. What can I do for ya?",
      "source_text": "Thanks. What can I do for ya?",
      "source_line_start": 10,
      "source_line_end": 10,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 11,
      "number": 110,
      "number_raw": "110",
      "source_number": "110",
      "audio": "",
      "source_audio": "",
      "text": "Do you do music anywhere else?",
      "source_text": "Do you do music anywhere else?",
      "source_line_start": 11,
      "source_line_end": 11,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 12,
      "number": 111,
      "number_raw": "111",
      "source_number": "111",
      "audio": "",
      "source_audio": "",
      "text": "Just felt like tossing some money in the hat, so to speak.",
      "source_text": "Just felt like tossing some money in the hat, so to speak.",
      "source_line_start": 12,
      "source_line_end": 12,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 13,
      "number": 112,
      "number_raw": "112",
      "source_number": "112",
      "audio": "",
      "source_audio": "",
      "text": "Where did you learn to sing?",
      "source_text": "Where did you learn to sing?",
      "source_line_start": 13,
      "source_line_end": 13,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 14,
      "number": 113,
      "number_raw": "113",
      "source_number": "113",
      "audio": "",
      "source_audio": "",
      "text": "Thanks for your time.",
      "source_text": "Thanks for your time.",
      "source_line_start": 14,
      "source_line_end": 14,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 15,
      "number": 114,
      "number_raw": "114",
      "source_number": "114",
      "audio": "",
      "source_audio": "",
      "text": "What?!? I don't have time for this.",
      "source_text": "What?!? I don't have time for this.",
      "source_line_start": 15,
      "source_line_end": 15,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 16,
      "number": 115,
      "number_raw": "115",
      "source_number": "115",
      "audio": "",
      "source_audio": "",
      "text": "Yeah, I sing at the Hub sometimes, and I've visited the Brotherhood of Steel and Adytum with the caravans. Why do you ask?",
      "source_text": "Yeah, I sing at the Hub sometimes, and I've visited the Brotherhood of\n Steel and Adytum with the caravans. Why do you ask?",
      "source_line_start": 16,
      "source_line_end": 17,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 17,
      "number": 116,
      "number_raw": "116",
      "source_number": "116",
      "audio": "",
      "source_audio": "",
      "text": "Can you tell me how to get to the Hub?",
      "source_text": "Can you tell me how to get to the Hub?",
      "source_line_start": 18,
      "source_line_end": 18,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 18,
      "number": 117,
      "number_raw": "117",
      "source_number": "117",
      "audio": "",
      "source_audio": "",
      "text": "I need to know how to get to the Brotherhood.",
      "source_text": "I need to know how to get to the Brotherhood.",
      "source_line_start": 19,
      "source_line_end": 19,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 19,
      "number": 118,
      "number_raw": "118",
      "source_number": "118",
      "audio": "",
      "source_audio": "",
      "text": "How do I get to Adytum?",
      "source_text": "How do I get to Adytum?",
      "source_line_start": 20,
      "source_line_end": 20,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 20,
      "number": 119,
      "number_raw": "119",
      "source_number": "119",
      "audio": "",
      "source_audio": "",
      "text": "Um, never mind, thanks.",
      "source_text": "Um, never mind, thanks.",
      "source_line_start": 21,
      "source_line_end": 21,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 21,
      "number": 120,
      "number_raw": "120",
      "source_number": "120",
      "audio": "",
      "source_audio": "",
      "text": "The Hub? Oh, it's just a short distance down south of Junktown. What else?",
      "source_text": "The Hub? Oh, it's just a short distance down south of Junktown. What else?",
      "source_line_start": 22,
      "source_line_end": 22,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 22,
      "number": 121,
      "number_raw": "121",
      "source_number": "121",
      "audio": "",
      "source_audio": "",
      "text": "The Brotherhood is a couple days west and a little bit north of here. Don't go there, though. They won't let you in unless you're with a caravan. You need anything else?",
      "source_text": "The Brotherhood is a couple days west and a little bit north of here.\n Don't go there, though. They won't let you in unless you're with a caravan.\n You need anything else?",
      "source_line_start": 23,
      "source_line_end": 25,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 23,
      "number": 122,
      "number_raw": "122",
      "source_number": "122",
      "audio": "",
      "source_audio": "",
      "text": "Hmm. Head southwest of the Hub. Adytum is part of the Boneyard. It's a small, semi-industrial town. I didn't like it much there. What else do you want?",
      "source_text": "Hmm. Head southwest of the Hub. Adytum is part of the Boneyard. It's a\n small, semi-industrial town. I didn't like it much there. What else do you want?",
      "source_line_start": 26,
      "source_line_end": 27,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 24,
      "number": 123,
      "number_raw": "123",
      "source_number": "123",
      "audio": "",
      "source_audio": "",
      "text": "Hey, thanks. It's hard being a starving artist. You got anything you need to know, you just ask.",
      "source_text": "Hey, thanks. It's hard being a starving artist. You got anything you\n need to know, you just ask.",
