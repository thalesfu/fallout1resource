  "entries": [
    {
      "occurrence": 1,
      "number": 100,
      "number_raw": "100",
      "source_number": "100",
      "audio": "",
      "source_audio": "",
      "text": "You see a dirty, grubby prisoner.",
      "source_text": "You see a dirty, grubby prisoner.",
      "source_line_start": 1,
      "source_line_end": 1,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 2,
      "number": 101,
      "number_raw": "101",
      "source_number": "101",
      "audio": "",
      "source_audio": "",
      "text": "One prisoner in the second cell is not like the others. He stands tall and looks you squarely in the eye.",
      "source_text": "One prisoner in the second cell is not like the others. He stands\n tall and looks you squarely in the eye.",
      "source_line_start": 2,
      "source_line_end": 3,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 3,
      "number": 102,
      "number_raw": "102",
      "source_number": "102",
      "audio": "",
      "source_audio": "",
      "text": "The prisoner stares blankly at the wall.",
      "source_text": "The prisoner stares blankly at the wall.",
      "source_line_start": 4,
      "source_line_end": 4,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 4,
      "number": 103,
      "number_raw": "103",
      "source_number": "103",
      "audio": "",
      "source_audio": "",
      "text": "The prisoner ignores your attempts to talk.",
      "source_text": "The prisoner ignores your attempts to talk.",
      "source_line_start": 5,
      "source_line_end": 5,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 5,
      "number": 104,
      "number_raw": "104",
      "source_number": "104",
      "audio": "",
      "source_audio": "",
      "text": "He looks wildly at you for a moment, and then turns away.",
      "source_text": "He looks wildly at you for a moment, and then turns away.",
      "source_line_start": 6,
      "source_line_end": 6,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 6,
      "number": 105,
      "number_raw": "105",
      "source_number": "105",
      "audio": "",
      "source_audio": "",
      "text": "She looks at you for a moment, and then drools.",
      "source_text": "She looks at you for a moment, and then drools.",
      "source_line_start": 7,
      "source_line_end": 7,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 7,
      "number": 106,
      "number_raw": "106",
      "source_number": "106",
      "audio": "",
      "source_audio": "",
      "text": "You get no response.",
      "source_text": "You get no response.",
      "source_line_start": 8,
      "source_line_end": 8,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 8,
      "number": 107,
      "number_raw": "107",
      "source_number": "107",
      "audio": "",
      "source_audio": "",
      "text": "We're free! We're free!",
      "source_text": "We're free! We're free!",
      "source_line_start": 9,
      "source_line_end": 9,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 9,
      "number": 108,
      "number_raw": "108",
      "source_number": "108",
      "audio": "",
      "source_audio": "",
      "text": "Your kind is repugnant. Do not speak to me.",
      "source_text": "Your kind is repugnant. Do not speak to me.",
      "source_line_start": 10,
      "source_line_end": 10,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 10,
      "number": 109,
      "number_raw": "109",
      "source_number": "109",
      "audio": "",
      "source_audio": "",
      "text": "Quib!",
      "source_text": "Quib!",
      "source_line_start": 11,
      "source_line_end": 11,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 11,
      "number": 110,
      "number_raw": "110",
      "source_number": "110",
      "audio": "",
      "source_audio": "",
      "text": "You don't have the right to speak to me like that.",
      "source_text": "You don't have the right to speak to me like that.",
      "source_line_start": 12,
      "source_line_end": 12,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 12,
      "number": 111,
      "number_raw": "111",
      "source_number": "111",
      "audio": "",
      "source_audio": "",
      "text": "You don't understand. I'm here to free you.",
      "source_text": "You don't understand. I'm here to free you.",
      "source_line_start": 13,
      "source_line_end": 13,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 13,
      "number": 112,
      "number_raw": "112",
      "source_number": "112",
      "audio": "",
      "source_audio": "",
      "text": "Do not mock me.",
      "source_text": "Do not mock me.",
      "source_line_start": 14,
      "source_line_end": 14,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 14,
      "number": 113,
      "number_raw": "113",
      "source_number": "113",
      "audio": "",
      "source_audio": "",
      "text": "I have no rights, and I could care less. Go away, and leave us alone.",
      "source_text": "I have no rights, and I could care less. Go away, and leave us alone.",
      "source_line_start": 15,
      "source_line_end": 15,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 15,
      "number": 114,
      "number_raw": "114",
      "source_number": "114",
      "audio": "",
      "source_audio": "",
      "text": "I refuse to tell you any information. Leave me alone.",
      "source_text": "I refuse to tell you any information. Leave me alone.",
      "source_line_start": 16,
      "source_line_end": 16,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 16,
      "number": 115,
      "number_raw": "115",
      "source_number": "115",
      "audio": "",
      "source_audio": "",
      "text": "Hng!!",
      "source_text": "Hng!!",
      "source_line_start": 17,
      "source_line_end": 17,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 17,
      "number": 116,
      "number_raw": "116",
      "source_number": "116",
      "audio": "",
      "source_audio": "",
      "text": "I'm really here to free you. I'm a normal human.",
      "source_text": "I'm really here to free you. I'm a normal human.",
      "source_line_start": 18,
      "source_line_end": 18,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 18,
      "number": 117,
      "number_raw": "117",
      "source_number": "117",
      "audio": "",
      "source_audio": "",
      "text": "If you want it that way. Sure. Goodbye.",
      "source_text": "If you want it that way. Sure. Goodbye.",
      "source_line_start": 19,
      "source_line_end": 19,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 19,
      "number": 118,
      "number_raw": "118",
      "source_number": "118",
      "audio": "",
      "source_audio": "",
      "text": "Don't you remember that you tried that trick last week? I didn't fall for it then, and I'm not going to start now.",
      "source_text": "Don't you remember that you tried that trick last week? I didn't\n fall for it then, and I'm not going to start now.",
      "source_line_start": 20,
      "source_line_end": 21,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 20,
      "number": 119,
      "number_raw": "119",
      "source_number": "119",
      "audio": "",
      "source_audio": "",
      "text": "What? No cowl to hind behind? Your traitorous nature is self-evident.",
      "source_text": "What? No cowl to hind behind? Your traitorous nature is self-evident.",
      "source_line_start": 22,
      "source_line_end": 22,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 21,
      "number": 120,
      "number_raw": "120",
      "source_number": "120",
      "audio": "",
      "source_audio": "",
      "text": "I'm here to free you.",
      "source_text": "I'm here to free you.",
      "source_line_start": 23,
      "source_line_end": 23,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 22,
      "number": 121,
      "number_raw": "121",
      "source_number": "121",
      "audio": "",
      "source_audio": "",
      "text": "Goodbye, then.",
      "source_text": "Goodbye, then.",
      "source_line_start": 24,
      "source_line_end": 24,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 23,
      "number": 122,
      "number_raw": "122",
      "source_number": "122",
      "audio": "",
      "source_audio": "",
      "text": "You are cruel. Leave us alone.",
      "source_text": "You are cruel. Leave us alone.",
      "source_line_start": 25,
      "source_line_end": 25,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 24,
      "number": 123,
      "number_raw": "123",
      "source_number": "123",
      "audio": "",
      "source_audio": "",
      "text": "I won't spill the beans about my people. You cannot force a man to betray himself, you can only force a man to stop living.",
      "source_text": "I won't spill the beans about my people. You cannot force a man to\n betray himself, you can only force a man to stop living.",
      "source_line_start": 26,
      "source_line_end": 27,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
