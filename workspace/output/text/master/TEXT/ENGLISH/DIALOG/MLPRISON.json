      "source_number": "125",
      "audio": "",
      "source_audio": "",
      "text": "I don't even have to force you to rot in hell. You're doing a fine job on your own.",
      "source_text": "I don't even have to force you to rot in hell. You're doing a fine\n job on your own.",
      "source_line_start": 29,
      "source_line_end": 30,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
