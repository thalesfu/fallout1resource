      "number_raw": "126",
      "source_number": "126",
      "audio": "",
      "source_audio": "",
      "text": "You're still mocking me.",
      "source_text": "You're still mocking me.",
      "source_line_start": 31,
      "source_line_end": 31,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
