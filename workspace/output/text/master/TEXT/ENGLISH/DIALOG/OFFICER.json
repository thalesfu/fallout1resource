    {
      "occurrence": 1,
      "number": 100,
      "number_raw": "100",
      "source_number": "100",
      "audio": "",
      "source_audio": "",
      "text": "You! Stop right there and face the law!",
      "source_text": "You! Stop right there and face the law!",
      "source_line_start": 1,
      "source_line_end": 1,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 2,
      "number": 101,
      "number_raw": "101",
      "source_number": "101",
      "audio": "",
      "source_audio": "",
      "text": "Thank you for returning the water-chip. It's really going to help morale, and keep people from breaking vault law.",
      "source_text": "Thank you for returning the water-chip. It's really\n going to help morale, and keep people from breaking vault law.",
      "source_line_start": 2,
      "source_line_end": 3,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 3,
      "number": 102,
      "number_raw": "102",
      "source_number": "102",
      "audio": "",
      "source_audio": "",
      "text": "Good to see you again. Is there anything that I can do for you?",
      "source_text": "Good to see you again. Is there anything that I can do for you?",
      "source_line_start": 4,
      "source_line_end": 4,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 4,
      "number": 103,
      "number_raw": "103",
      "source_number": "103",
      "audio": "",
      "source_audio": "",
      "text": "What do you do?",
      "source_text": "What do you do?",
      "source_line_start": 5,
      "source_line_end": 5,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 5,
      "number": 104,
      "number_raw": "104",
      "source_number": "104",
      "audio": "",
      "source_audio": "",
      "text": "Yeah, I need some weapons.",
      "source_text": "Yeah, I need some weapons.",
      "source_line_start": 6,
      "source_line_end": 6,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 6,
      "number": 105,
      "number_raw": "105",
      "source_number": "105",
      "audio": "",
      "source_audio": "",
      "text": "Why would there be a locked door in the Vault?",
      "source_text": "Why would there be a locked door in the Vault?",
      "source_line_start": 7,
      "source_line_end": 7,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 7,
      "number": 106,
      "number_raw": "106",
      "source_number": "106",
      "audio": "",
      "source_audio": "",
      "text": "Glop!",
      "source_text": "Glop!",
      "source_line_start": 8,
      "source_line_end": 8,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 8,
      "number": 107,
      "number_raw": "107",
      "source_number": "107",
      "audio": "",
      "source_audio": "",
      "text": "Hmmm. I think you should be somewhere else besides here. Have a nice day.",
      "source_text": "Hmmm. I think you should be somewhere else besides here. Have a nice day.",
      "source_line_start": 9,
      "source_line_end": 9,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 9,
      "number": 108,
      "number_raw": "108",
      "source_number": "108",
      "audio": "",
      "source_audio": "",
      "text": "I'm in charge of Vault security and law enforcement. You might not know it, but the Vault wouldn't run as well if it wasn't for me.",
      "source_text": "I'm in charge of Vault security and law enforcement.\n You might not know it, but the Vault wouldn't run as well if it wasn't for me.",
      "source_line_start": 10,
      "source_line_end": 11,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 10,
      "number": 109,
      "number_raw": "109",
      "source_number": "109",
      "audio": "",
      "source_audio": "",
      "text": "Hmm. Neat. Thanks.",
      "source_text": "Hmm. Neat. Thanks.",
      "source_line_start": 12,
      "source_line_end": 12,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 11,
      "number": 110,
      "number_raw": "110",
      "source_number": "110",
      "audio": "",
      "source_audio": "",
      "text": "Sounds important.",
      "source_text": "Sounds important.",
      "source_line_start": 13,
      "source_line_end": 13,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 12,
      "number": 111,
      "number_raw": "111",
      "source_number": "111",
      "audio": "",
      "source_audio": "",
      "text": "It is. Without proper adherence to the laws, the Vault would soon be a lawless place, with no direction. That would jeopardize the safety of us all.",
      "source_text": "It is. Without proper adherence to the laws, the Vault\n would soon be a lawless place, with no direction. That would jeopardize\n the safety of us all.",
      "source_line_start": 14,
      "source_line_end": 16,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 13,
      "number": 112,
      "number_raw": "112",
      "source_number": "112",
      "audio": "",
      "source_audio": "",
      "text": "Now that I've been outside, are there any laws that apply specifically to me?",
      "source_text": "Now that I've been outside, are there any laws that\n apply specifically to me?",
      "source_line_start": 17,
      "source_line_end": 18,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 14,
      "number": 113,
      "number_raw": "113",
      "source_number": "113",
      "audio": "",
      "source_audio": "",
      "text": "I've seen some places on the outside world that suffer because they have no laws.",
      "source_text": "I've seen some places on the outside world that suffer\n because they have no laws.",
      "source_line_start": 19,
      "source_line_end": 20,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 15,
      "number": 114,
      "number_raw": "114",
      "source_number": "114",
      "audio": "",
      "source_audio": "",
      "text": "Well, even if weapons are required on the outside world, don't display them in a threatening manner in here. Other than that, I can't think of anything in particular.",
      "source_text": "Well, even if weapons are required on the outside world,\n don't display them in a threatening manner in here.\n Other than that, I can't think of anything in particular.",
      "source_line_start": 21,
      "source_line_end": 23,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 16,
      "number": 115,
      "number_raw": "115",
      "source_number": "115",
      "audio": "",
      "source_audio": "",
      "text": "Thanks.",
      "source_text": "Thanks.",
      "source_line_start": 24,
      "source_line_end": 24,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 17,
      "number": 116,
      "number_raw": "116",
      "source_number": "116",
      "audio": "",
      "source_audio": "",
      "text": "You see, I knew that would happen. People obeying law is the only thing that has saved the Vault from misery and destruction. Keep up the good work.",
      "source_text": "You see, I knew that would happen. People obeying law\n is the only thing that has saved the Vault from misery\n and destruction. Keep up the good work.",
      "source_line_start": 25,
      "source_line_end": 27,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 18,
      "number": 117,
      "number_raw": "117",
      "source_number": "117",
      "audio": "",
      "source_audio": "",
      "text": "The Overseer has not authorized me to open the armory and get you more weapons. I'm sorry, but I can't help you. ",
      "source_text": "The Overseer has not authorized me to open the armory and\n get you more weapons. I'm sorry, but I can't help you. ",
      "source_line_start": 28,
      "source_line_end": 29,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 19,
      "number": 118,
      "number_raw": "118",
      "source_number": "118",
      "audio": "",
      "source_audio": "",
      "text": "Please! I really need them!",
      "source_text": "Please! I really need them!",
      "source_line_start": 30,
      "source_line_end": 30,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 20,
      "number": 119,
      "number_raw": "119",
      "source_number": "119",
      "audio": "",
      "source_audio": "",
      "text": "Ok. Thanks, anyways.",
      "source_text": "Ok. Thanks, anyways.",
      "source_line_start": 31,
      "source_line_end": 31,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 21,
      "number": 120,
