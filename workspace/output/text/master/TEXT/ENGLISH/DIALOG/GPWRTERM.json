      "source_number": "231",
      "audio": "",
      "source_audio": "",
      "text": "Power Armor Specs:                                                     The T-51b Powered Infantry Armor is designed with the latest passive defense features for both civilian and military disturbances. ",
      "source_text": "Power Armor Specs:\n                                                     The T-51b Powered Infantry\n Armor is designed with the latest passive defense features for both civilian and\n military disturbances. ",
      "source_line_start": 135,
