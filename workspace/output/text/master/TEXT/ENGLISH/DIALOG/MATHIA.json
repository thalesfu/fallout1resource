      "number_raw": "105",
      "source_number": "105",
      "audio": "",
      "source_audio": "",
      "text": "The name is Mathia. I am officially Maxson's assistant, but I am also here to make sure no one messes with the old man.",
      "source_text": "The name is Mathia. I am officially Maxson's assistant, but\n I am also here to make sure no one messes with the old man.",
