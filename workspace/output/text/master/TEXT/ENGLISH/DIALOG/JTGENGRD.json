      "number_raw": "128",
      "source_number": "128",
      "audio": "",
      "source_audio": "",
      "text": "Whatever you're doing, don't do it in this town.",
      "source_text": "Whatever you're doing, don't do it in this town.",
      "source_line_start": 39,
      "source_line_end": 39,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
