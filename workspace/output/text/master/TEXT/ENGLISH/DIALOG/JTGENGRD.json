      "number_raw": "100",
      "source_number": "100",
      "audio": "",
      "source_audio": "",
      "text": "He looks like an experienced guardsman.",
      "source_text": "He looks like an experienced guardsman.",
      "source_line_start": 1,
      "source_line_end": 1,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
