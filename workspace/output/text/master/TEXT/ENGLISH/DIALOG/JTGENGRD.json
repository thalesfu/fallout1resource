    },
    {
      "occurrence": 2,
      "number": 101,
      "number_raw": "101",
      "source_number": "101",
      "audio": "",
      "source_audio": "",
      "text": "You'd better watch yourself here.",
      "source_text": "You'd better watch yourself here.",
      "source_line_start": 2,
      "source_line_end": 2,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 3,
      "number": 102,
      "number_raw": "102",
      "source_number": "102",
      "audio": "",
      "source_audio": "",
      "text": "This isn't a good town to get in trouble in.",
      "source_text": "This isn't a good town to get in trouble in.",
      "source_line_start": 3,
      "source_line_end": 3,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 4,
      "number": 103,
      "number_raw": "103",
      "source_number": "103",
      "audio": "",
      "source_audio": "",
      "text": "Behave, and we won't have to get nasty.",
      "source_text": "Behave, and we won't have to get nasty.",
      "source_line_start": 4,
      "source_line_end": 4,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 5,
      "number": 104,
      "number_raw": "104",
      "source_number": "104",
      "audio": "",
      "source_audio": "",
      "text": "You're ok.",
      "source_text": "You're ok.",
      "source_line_start": 5,
      "source_line_end": 5,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 6,
      "number": 105,
      "number_raw": "105",
      "source_number": "105",
      "audio": "",
      "source_audio": "",
      "text": "Keep up the good work.",
      "source_text": "Keep up the good work.",
      "source_line_start": 6,
      "source_line_end": 6,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 7,
      "number": 106,
      "number_raw": "106",
      "source_number": "106",
      "audio": "",
      "source_audio": "",
      "text": "Nice day, isn't it?",
      "source_text": "Nice day, isn't it?",
      "source_line_start": 7,
      "source_line_end": 7,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 8,
      "number": 107,
      "number_raw": "107",
      "source_number": "107",
      "audio": "",
      "source_audio": "",
      "text": "This is Junktown. Nice place to live, as long as you stay on our good side.",
      "source_text": "This is Junktown. Nice place to live, as long as you stay on\n our good side.",
      "source_line_start": 8,
      "source_line_end": 9,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 9,
      "number": 108,
      "number_raw": "108",
      "source_number": "108",
      "audio": "",
      "source_audio": "",
      "text": "Watch out for Gizmo and his cronies.",
      "source_text": "Watch out for Gizmo and his cronies.",
      "source_line_start": 10,
      "source_line_end": 10,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 10,
      "number": 109,
      "number_raw": "109",
      "source_number": "109",
      "audio": "",
      "source_audio": "",
      "text": "I like my boss.",
      "source_text": "I like my boss.",
      "source_line_start": 11,
      "source_line_end": 11,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 11,
      "number": 110,
      "number_raw": "110",
      "source_number": "110",
      "audio": "",
      "source_audio": "",
      "text": "You'd better put that away. Junktown is a friendly place, friend, and we want to keep it that way.",
      "source_text": "You'd better put that away. Junktown is a friendly place, friend, and we\n want to keep it that way.",
      "source_line_start": 12,
      "source_line_end": 13,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 12,
      "number": 111,
      "number_raw": "111",
      "source_number": "111",
      "audio": "",
      "source_audio": "",
      "text": "Put what away?",
      "source_text": "Put what away?",
      "source_line_start": 14,
      "source_line_end": 14,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 13,
      "number": 112,
      "number_raw": "112",
      "source_number": "112",
      "audio": "",
      "source_audio": "",
      "text": "Don't tell me what to do, loser boy.",
      "source_text": "Don't tell me what to do, loser boy.",
      "source_line_start": 15,
      "source_line_end": 15,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 14,
      "number": 113,
      "number_raw": "113",
      "source_number": "113",
      "audio": "",
      "source_audio": "",
      "text": "Sounds fair. By the way, what is the local law regarding weapons?",
      "source_text": "Sounds fair. By the way, what is the local law regarding weapons?",
      "source_line_start": 16,
      "source_line_end": 16,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 15,
      "number": 114,
      "number_raw": "114",
      "source_number": "114",
      "audio": "",
      "source_audio": "",
      "text": "Uh,oh.",
      "source_text": "Uh,oh.",
      "source_line_start": 17,
      "source_line_end": 17,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 16,
      "number": 115,
      "number_raw": "115",
      "source_number": "115",
      "audio": "",
      "source_audio": "",
      "text": "Your weapon, idiot. Killian won't take your arms away, but you'd better damn well keep them in your holster.",
      "source_text": "Your weapon, idiot. Killian won't take your arms away, but you'd\n better damn well keep them in your holster.",
      "source_line_start": 18,
      "source_line_end": 19,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 17,
      "number": 116,
      "number_raw": "116",
      "source_number": "116",
      "audio": "",
      "source_audio": "",
      "text": "Oh, sorry.",
      "source_text": "Oh, sorry.",
      "source_line_start": 20,
      "source_line_end": 20,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 18,
      "number": 117,
      "number_raw": "117",
      "source_number": "117",
      "audio": "",
      "source_audio": "",
      "text": "No way! I'm not putting down my shooters for nobody!",
      "source_text": "No way! I'm not putting down my shooters for nobody!",
      "source_line_start": 21,
      "source_line_end": 21,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 19,
      "number": 118,
      "number_raw": "118",
      "source_number": "118",
      "audio": "",
      "source_audio": "",
      "text": "You'd better behave, since it's the law, and I enforce the law. Put your weapon away, don't draw it unless in self-defense, and you won't have a problem with us guards. Disobey the law, and we will return you to the lawless wasteland - dead or alive.",
      "source_text": "You'd better behave, since it's the law, and I enforce the law.\n Put your weapon away, don't draw it unless in self-defense, and\n you won't have a problem with us guards. Disobey the law, and we\n will return you to the lawless wasteland - dead or alive.",
      "source_line_start": 22,
      "source_line_end": 25,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 20,
      "number": 119,
      "number_raw": "119",
      "source_number": "119",
      "audio": "",
      "source_audio": "",
      "text": "Sure, since you put it that way.",
      "source_text": "Sure, since you put it that way.",
      "source_line_start": 26,
      "source_line_end": 26,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 21,
      "number": 120,
      "number_raw": "120",
      "source_number": "120",
      "audio": "",
      "source_audio": "",
      "text": "Bite your laws!",
      "source_text": "Bite your laws!",
      "source_line_start": 27,
      "source_line_end": 27,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 22,
      "number": 121,
      "number_raw": "121",
      "source_number": "121",
      "audio": "",
      "source_audio": "",
      "text": "Well, uh, fine with me. But you'd better be careful.",
      "source_text": "Well, uh, fine with me. But you'd better be careful.",
      "source_line_start": 28,
      "source_line_end": 28,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 23,
      "number": 122,
      "number_raw": "122",
      "source_number": "122",
      "audio": "",
      "source_audio": "",
      "text": "Good you asked. No weapons can be drawn except in self-defense. If you start a fight, it's your fault. Other than that, it's your right to go around armed. Just don't pull a knife or gun without just cause. Have a good day.",
      "source_text": "Good you asked. No weapons can be drawn except in self-defense. If\n you start a fight, it's your fault. Other than that, it's your right\n to go around armed. Just don't pull a knife or gun without just\n cause. Have a good day.",
      "source_line_start": 29,
      "source_line_end": 32,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 24,
      "number": 123,
      "number_raw": "123",
      "source_number": "123",
      "audio": "",
      "source_audio": "",
      "text": "Hey you, no weapons! And I don't care if your momma dropped you on your head as a kid. No weapons.",
      "source_text": "Hey you, no weapons! And I don't care if your momma dropped you on\n your head as a kid. No weapons.",
      "source_line_start": 33,
      "source_line_end": 34,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 25,
      "number": 124,
      "number_raw": "124",
      "source_number": "124",
      "audio": "",
      "source_audio": "",
      "text": "Hey! You! What are you doing sneaking around?",
      "source_text": "Hey! You! What are you doing sneaking around?",
      "source_line_start": 35,
      "source_line_end": 35,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 26,
      "number": 125,
      "number_raw": "125",
      "source_number": "125",
      "audio": "",
      "source_audio": "",
      "text": "Nothing.",
      "source_text": "Nothing.",
      "source_line_start": 36,
      "source_line_end": 36,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 27,
      "number": 126,
      "number_raw": "126",
      "source_number": "126",
      "audio": "",
      "source_audio": "",
      "text": "I'm not sneaking around. I just like to walk cautiously.",
      "source_text": "I'm not sneaking around. I just like to walk cautiously.",
      "source_line_start": 37,
      "source_line_end": 37,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
      "occurrence": 28,
      "number": 127,
      "number_raw": "127",
      "source_number": "127",
      "audio": "",
      "source_audio": "",
      "text": "Uhhh.",
      "source_text": "Uhhh.",
      "source_line_start": 38,
      "source_line_end": 38,
      "number_occurrence": 1,
      "number_occurrence_count": 1,
      "effective": true
    },
    {
